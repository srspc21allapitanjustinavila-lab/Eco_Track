# EcoTrack local development settings. PHP loads this file when matching
# environment variables are not already provided by Apache or the host.
APP_ENV=development
DB_HOST=localhost
DB_NAME=ecotrack_db
DB_USER=root
DB_PASS=

# Leave SMTP blank until a new credential has been created outside source control.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=EcoTrack System
PASSWORD_RESET_ENABLED=false

# Optional. Without a key, dashboard explanations use the built-in rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

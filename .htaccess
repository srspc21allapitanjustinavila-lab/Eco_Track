RewriteEngine On

# Preserve existing bookmarks while application routes use descriptive names.
RewriteRule ^Login\.php$ login.php [R=302,L]
RewriteRule ^Waste_data\.php$ waste_records.php [R=302,L]
RewriteRule ^dss\.php$ admin_collection_schedule.php [R=302,L]
RewriteRule ^dss_responsive_preview\.php$ admin_collection_schedule_preview.php [R=302,L]
RewriteRule ^staff_dashboard\.php$ staff_home.php [R=302,L]
RewriteRule ^upload_csv\.php$ admin_waste_import.php [R=302,L]
RewriteRule ^heatmap\.php$ waste_heatmap.php [R=302,L]
RewriteRule ^report\.php$ admin_operations_reports.php [R=302,L]
RewriteRule ^manage_users\.php$ admin_user_management.php [R=302,L]
RewriteRule ^settings\.php$ system_settings.php [R=302,L]
RewriteRule ^create_user\.php$ admin_user_creation.php [R=302,L]
RewriteRule ^daily_task\.php$ staff_daily_tasks.php [R=302,L]
RewriteRule ^daily_tasks\.php$ staff_daily_tasks.php [R=302,L]
RewriteRule ^announcement\.php$ staff_announcements.php [R=302,L]
RewriteRule ^announcements\.php$ staff_announcements.php [R=302,L]
RewriteRule ^forgot_password\.php$ password_reset_request.php [R=302,L]
RewriteRule ^verify_code\.php$ password_reset_verification.php [R=302,L]
RewriteRule ^reset_password\.php$ password_reset.php [R=302,L]
RewriteRule ^two_factor_verify\.php$ two_factor_verification.php [R=302,L]
RewriteRule ^unauthorized\.php$ access_denied.php [R=302,L]
RewriteRule ^legacy_heatmap_redirect\.php$ route_planning_redirect.php [R=302,L]
RewriteRule ^legacy_role_redirect\.php$ role_landing_redirect.php [R=302,L]

# Copy to /etc/apache2/ecotrack-secrets.conf on the VM. Do not commit that file.
SetEnv DB_HOST "127.0.0.1"
SetEnv DB_NAME "ecotrack_db"
SetEnv DB_USER "ecotrack_app"
SetEnv DB_PASS "REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD"

# Password reset stays disabled until all SMTP values below are set and
# PASSWORD_RESET_ENABLED is changed to true in ecotrack.conf.
SetEnv EMAIL_HOST ""
SetEnv EMAIL_PORT "587"
SetEnv EMAIL_USERNAME ""
SetEnv EMAIL_PASSWORD ""
SetEnv EMAIL_FROM ""
SetEnv EMAIL_FROM_NAME "EcoTrack System"

# Optional: leave blank to use EcoTrack's rule-based dashboard explanations.
SetEnv OPENAI_API_KEY ""
SetEnv OPENAI_MODEL "gpt-4o-mini"

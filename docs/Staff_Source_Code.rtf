\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#f44336";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: WEAK";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \} else if (strength <= 4) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.width = "60%";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#ff9800";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: MEDIUM";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.width = "100%";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#4caf50";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: STRONG";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // requested four-band waste classification.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'waste_level' => $classification,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

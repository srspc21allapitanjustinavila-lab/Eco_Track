\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteRecordEffectiveKg($record)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $componentColumns = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'tuesday_factory_returnable_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'wednesday_biowaste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'thursday_factory_returnable_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'friday_biowaste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'saturday_hazard_waste_kg',\par

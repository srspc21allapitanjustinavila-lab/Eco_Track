\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($categoryTotals as $category => $unused) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($categoryFilter === 'all' || $category === $categoryFilter) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $categoryTotals[$category] += (float)($row['categories'][$category] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseKey = strtolower($row['phase_name']);\par

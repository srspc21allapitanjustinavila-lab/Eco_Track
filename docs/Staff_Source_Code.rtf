\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasSkippedCount) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_import_events ADD COLUMN skipped_row_count INT NOT NULL DEFAULT 0 AFTER valid_row_count');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("CREATE TABLE IF NOT EXISTS waste_import_event_issues (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,\par

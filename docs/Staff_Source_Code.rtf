\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function storeWasteImportBatchDailyAllocations($conn, $batchId)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $conn->prepare('SELECT wr.* FROM waste_records wr INNER JOIN waste_import_staging_rows s ON s.record_fingerprint = wr.record_fingerprint WHERE s.batch_id = ? AND wr.is_active = 1 ORDER BY wr.id');\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'category' => $category,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'start_date' => $startDate ?: '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'end_date' => $endDate ?: '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return a safe YYYY-MM month value used by the Street month controls. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteStreetMonthValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

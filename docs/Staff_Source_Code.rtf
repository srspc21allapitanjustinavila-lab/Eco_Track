\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const staffDashboardLoadedAt = Date.now();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         let staffWasteVersion = Number(<?php echo json_encode((int)($wasteDataState['version'] ?? 0)); ?>);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function refreshStaffDashboardWhenWasteDataChanges() \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (document.hidden) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

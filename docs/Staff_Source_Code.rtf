\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Accept an optional calendar year supplied by a visualization filter.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteCollectionYear($year)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = trim((string)$year);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!preg_match('/^(19|20)\\d\{2\}$/', $year)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $year;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Resolve a requested reporting year against values actually represented by\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * active saved/imported waste data.  URL tampering must not create a phantom\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * calendar option in a visualisation control.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function resolveImportedWasteCollectionYear($requestedYear, array $availableYears)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedYear = normalizeWasteCollectionYear($requestedYear);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($requestedYear === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($availableYears as $year) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((string)$year === $requestedYear) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return $requestedYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteCollectionMonth($month)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $month = filter_var($month, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 12]]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $month === false ? '' : (string)$month;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Normalize an exact calendar period used by data-backed dashboard controls. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteCollectionPeriod($period)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $period = trim((string)$period);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return preg_match('/^(19|20)\\d\{2\}-(0[1-9]|1[0-2])$/', $period) ? $period : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build the selectable years and months from active records with stored dates. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildActiveWasteCollectionPeriodOptions(array $periods)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $validPeriods = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($periods as $period) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $period = normalizeWasteCollectionPeriod($period);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($period !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $validPeriods[$period] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $validPeriods = array_keys($validPeriods);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     rsort($validPeriods, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $monthsByYear = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($validPeriods as $period) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $year = substr($period, 0, 4);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $month = (int)substr($period, 5, 2);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $monthsByYear[$year][$month] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($monthsByYear as &$months) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $months = array_keys($months);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         rsort($months, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($months);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'periods' => $validPeriods,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'years' => array_map('strval', array_keys($monthsByYear)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'months_by_year' => $monthsByYear,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return exact YYYY-MM periods represented by active, stored waste records. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getActiveWasteCollectionPeriods($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->query("\\n            SELECT DISTINCT DATE_FORMAT(collection_date, '%Y-%m') AS collection_period\\n            FROM waste_records\\n            WHERE is_active = 1 AND collection_date IS NOT NULL\\n            ORDER BY collection_period DESC\\n        ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return buildActiveWasteCollectionPeriodOptions($stmt->fetchAll(PDO::FETCH_COLUMN));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to load active waste collection periods: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['periods' => [], 'years' => [], 'months_by_year' => []];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Resolve a requested period to an actual period, optionally within one year. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function resolveActiveWasteCollectionPeriod($requestedPeriod, $requestedYear, array $periodOptions)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $periods = $periodOptions['periods'] ?? [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedPeriod = normalizeWasteCollectionPeriod($requestedPeriod);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedYear = normalizeWasteCollectionYear($requestedYear);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($requestedYear !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($requestedPeriod !== '' && substr($requestedPeriod, 0, 4) === $requestedYear && in_array($requestedPeriod, $periods, true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return $requestedPeriod;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($periods as $period) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (substr($period, 0, 4) === $requestedYear) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 return $period;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($requestedPeriod !== '' && in_array($requestedPeriod, $periods, true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $requestedPeriod;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $periods[0] ?? '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return saved collection years, newest first, for shared controls. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getWasteCollectionYears($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $conn->query("\\n        SELECT DISTINCT YEAR(collection_date) AS collection_year\\n        FROM waste_records\\n        WHERE collection_date IS NOT NULL AND is_active = 1\\n        ORDER BY collection_year DESC\\n    ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $years = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $year) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $year = normalizeWasteCollectionYear($year);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($year !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $years[] = $year;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $years;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Return calendar periods represented by active uploaded data, including\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * daily allocations from reporting ranges spanning months or years.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getImportedWasteCalendarPeriods($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return buildActiveWasteCollectionPeriodOptions([]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteDailyAllocationTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->query("SELECT DISTINCT collection_period FROM (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             SELECT DATE_FORMAT(collection_date, '%Y-%m') AS collection_period\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             FROM waste_records\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE is_active = 1 AND collection_date IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             UNION\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             SELECT DATE_FORMAT(da.allocation_date, '%Y-%m') AS collection_period\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             FROM waste_daily_allocations da\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INNER JOIN waste_records wr ON wr.id = da.waste_record_id\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE wr.is_active = 1 AND da.allocation_date IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ) imported_periods\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         WHERE collection_period IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ORDER BY collection_period DESC");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return buildActiveWasteCollectionPeriodOptions($stmt->fetchAll(PDO::FETCH_COLUMN));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to load imported waste calendar periods: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return buildActiveWasteCollectionPeriodOptions([]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return only years represented by active uploaded collection periods. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getImportedWasteCalendarYears($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_map('intval', getImportedWasteCalendarPeriods($conn)['years']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return imported calendar years as HTML-safe string options, newest first. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getImportedWasteCollectionYearOptions($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_map('strval', getImportedWasteCalendarYears($conn));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Return the real Collection Group labels that can be selected for active\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Waste Data filters and manual entries.  Historic rows can use the legacy\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * phase columns, so they remain visible through the same fallback used by the\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Waste Data page.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getActiveWasteCollectionGroups($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->query('SELECT collection_group, phase_number, phase_date_label, date FROM waste_records WHERE is_active = 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return buildActiveWasteCollectionGroups($stmt->fetchAll());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to load active waste collection groups: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build distinct saved Collection Group labels from active database rows. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildActiveWasteCollectionGroups(array $records)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $groups = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = wasteAnalyticsCollectionGroupFromLegacyLabel($record['collection_group'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($group === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach (['phase_number', 'phase_date_label', 'date'] as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $group = wasteAnalyticsCollectionGroupFromLegacyLabel($record[$column] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if ($group !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($group !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $groups[$group] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $groups = array_keys($groups);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     natcasesort($groups);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_values($groups);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Extract the saved collection-group portion of the older import labels.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  *\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * This deliberately lives in the analytics module rather than relying on the\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * application bootstrap helper so analytics and its unit tests remain usable\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * on their own.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteAnalyticsCollectionGroupFromLegacyLabel($sourceLabel)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceLabel = trim((string)$sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($sourceLabel === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phase = wasteAnalyticsPhaseGroupFromLabel($sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($phase !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $phase;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^(.*?)\\s*(?:[-\u8211?\u8212?]\\s*)?date\\s*:\\s*(.+)$/iu', $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return trim($matches[1], " \\t\\n\\r\\0\\x0B-\u8211?\u8212?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^(.*?)\\s*\\((.+)\\)\\s*$/u', $sourceLabel, $matches) && trim($matches[2]) !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return trim($matches[1]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $sourceLabel;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Normalize a saved or legacy Phase label without changing non-phase groups. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteAnalyticsPhaseGroupFromLabel($sourceLabel)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceLabel = trim((string)$sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!preg_match('/^\\s*phase\\s*([0-9]+(?:\\s*-?\\s*[a-z](?![a-z]))?)(?=\\s|\\(|$)/iu', $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseToken = strtoupper(preg_replace('/\\s+/', '', trim($matches[1])));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return 'Phase ' . $phaseToken;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return Waste Type filter values only for categories with saved positive data. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildAvailableWasteTypeOptions(array $records)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $available = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'factory returnable' => false,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'biowaste' => false,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'residual waste' => false,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'hazardous waste' => false,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'unclassified' => false,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $factoryDetail = wasteNumericValue($record['tuesday_factory_returnable_kg'] ?? 0) + wasteNumericValue($record['thursday_factory_returnable_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $factoryReturnable = $factoryDetail > 0 ? $factoryDetail : wasteNumericValue($record['recyclable_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $biowaste = wasteNumericValue($record['wednesday_biowaste_kg'] ?? 0) + wasteNumericValue($record['friday_biowaste_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $residualDetail = wasteNumericValue($record['residual_waste_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $residual = $residualDetail > 0 ? $residualDetail : wasteNumericValue($record['residual_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hazardousDetail = wasteNumericValue($record['saturday_hazard_waste_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hazardous = $hazardousDetail > 0 ? $hazardousDetail : wasteNumericValue($record['hazardous_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $unclassified = wasteNumericValue($record['unclassified_waste_kg'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $available['factory returnable'] = $available['factory returnable'] || $factoryReturnable > 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $available['biowaste'] = $available['biowaste'] || $biowaste > 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $available['residual waste'] = $available['residual waste'] || $residual > 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $available['hazardous waste'] = $available['hazardous waste'] || $hazardous > 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $available['unclassified'] = $available['unclassified'] || $unclassified > 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $labels = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'factory returnable' => 'Factory Returnable',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'biowaste' => 'Biowaste',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'residual waste' => 'Residual Waste',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'hazardous waste' => 'Hazardous Waste',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'unclassified' => 'Unclassified Waste',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_filter($labels, static function ($key) use ($available) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $available[$key];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}, ARRAY_FILTER_USE_KEY);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Apply a visualization's optional year without changing other views. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function filterWasteRecordsByCollectionYear($records, $year)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = normalizeWasteCollectionYear($year);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($year === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $records;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_values(array_filter($records, static function ($record) use ($year) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collectionDate = normalizeWasteDateValue($record['collection_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $collectionDate !== null && substr($collectionDate, 0, 4) === $year;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function filterWasteRecordsByCollectionPeriod($records, $year = '', $month = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = normalizeWasteCollectionYear($year);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $month = normalizeWasteCollectionMonth($month);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($year === '' && $month === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $records;\par

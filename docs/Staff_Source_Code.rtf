\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function logActivity($action, $module, $status = 'Success', $conn = null, $actor = null)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $conn = $conn ?: getDBConnection();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureActivityLogsTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $actor = $actor ?: ($_SESSION['user'] ?? []);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userId = !empty($actor['id']) ? (int)$actor['id'] : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userName = trim(($actor['first_name'] ?? '') . ' ' . ($actor['last_name'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($userName === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $userName = $actor['username'] ?? 'Unknown user';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userRole = ucfirst($actor['user_type'] ?? $actor['role'] ?? 'Guest');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $status = $status === 'Failed' ? 'Failed' : 'Success';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('INSERT INTO activity_logs (user_id, user_name, user_role, action, module, status) VALUES (?, ?, ?, ?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$userId, $userName, $userRole, $action, $module, $status]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par

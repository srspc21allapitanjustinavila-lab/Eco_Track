\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $source = preg_replace('/\\s*[-\u8211?\u8212?]?\\s*date\\s*:.*$/i', '', $source);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return trim($source) !== '' ? trim($source) : 'Unassigned area';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteDateValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($value === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Year-only uploads use the first day of that year for date-based charts.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^(19|20)\\d\{2\}$/', $value)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $value . '-01-01';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Excel may send an unformatted serial date from a non-leading column.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (is_numeric($value) && (float)$value > 20000 && (float)$value < 70000) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return gmdate('Y-m-d', (int)(((float)$value - 25569) * 86400));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $date = DateTimeImmutable::createFromFormat('!Y-m-d', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($date && $date->format('Y-m-d') === $value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $date->format('Y-m-d');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (['!Y/m/d', '!m/d/Y', '!d/m/Y'] as $format) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (password.length >= 6) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (password.length >= 10) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[A-Z]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[0-9]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[^A-Za-z0-9]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           fill.className = "strength-fill";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (strength <= 2) \{\par

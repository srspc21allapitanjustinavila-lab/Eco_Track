\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phases[$key]['total_waste'] += wasteNumericValue($allocation['kilogram_of_waste'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($recordId > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phases[$key]['record_ids'][$recordId] = true;\par

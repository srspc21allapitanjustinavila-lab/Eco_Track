\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (isset($seenFingerprints[$fingerprintKey])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $seenFingerprints[$fingerprintKey] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = normalizeWastePhaseLabel($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $street = trim(preg_replace('/\\s+/u', ' ', (string)($record['street'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($phaseName === '' || $phaseName === 'Unassigned Phase' || $street === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $sourceRows[] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'key' => wasteStreetComparisonKey($phaseName, $street),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'phase_name' => $phaseName,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'street' => $street,\par

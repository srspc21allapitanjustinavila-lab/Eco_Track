\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function settingToggleValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return (string)$value === '1' ? 1 : 0;\par

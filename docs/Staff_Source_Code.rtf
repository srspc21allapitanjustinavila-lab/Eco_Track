\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function saveUserSettings($conn, $userId, array $settings)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userId = (int)$userId;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $userId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     <script>\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       (function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var form = document.querySelector('.heatmap-period-form');\par

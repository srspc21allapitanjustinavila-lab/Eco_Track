\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getUserSettings($conn, $userId)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $defaults = getDefaultUserSettings();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userId = (int)$userId;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $userId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $defaults;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureUserSettingsTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('SELECT system_alerts, reports_reminder, high_waste_alerts, two_factor_enabled, session_timeout_minutes, auto_delete_old_reports, share_anonymized_data, data_export_enabled FROM user_settings WHERE user_id = ? LIMIT 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$userId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stored = $stmt->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$stored) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return $defaults;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (['system_alerts', 'reports_reminder', 'high_waste_alerts', 'two_factor_enabled', 'auto_delete_old_reports', 'share_anonymized_data', 'data_export_enabled'] as $booleanKey) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stored[$booleanKey] = (int)$stored[$booleanKey] ? 1 : 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stored['session_timeout_minutes'] = (int)$stored['session_timeout_minutes'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return array_merge($defaults, $stored);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to load user settings: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $defaults;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

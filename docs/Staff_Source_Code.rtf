\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteStreetComparison(array $records, array $filters = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filterState = buildWasteStreetFilterState($records, $filters);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $definitions = $filterState['definitions'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filters = $filterState['filters'];\par

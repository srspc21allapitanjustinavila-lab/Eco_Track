\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $format = strtolower((string)pathinfo((string)$fileName, PATHINFO_EXTENSION));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return in_array($format, ['csv', 'txt', 'xls', 'xlsx', 'xlsm', 'json', 'docx', 'pdf'], true) ? $format : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function logWasteImportEvent($conn, array $event)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $allowedOutcomes = ['imported', 'cancelled', 'duplicate', 'validation_error', 'expired', 'failed'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $outcome = (string)($event['outcome'] ?? 'failed');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!in_array($outcome, $allowedOutcomes, true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $outcome = 'failed';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fileName = substr(basename((string)($event['original_name'] ?? '')), 0, 255);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = strtolower(trim((string)($event['reason_code'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = preg_replace('/[^a-z0-9_-]+/', '_', $reasonCode);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = substr((string)$reasonCode, 0, 60);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $eventKey = trim((string)($event['event_key'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $eventKey = $eventKey === '' ? null : substr($eventKey, 0, 160);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ensureWasteImportAuditTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('INSERT IGNORE INTO waste_import_events\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             (event_key, actor_user_id, original_name, file_format, valid_row_count, skipped_row_count, outcome, reason_code, event_source)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             VALUES (?, ?, ?, ?, ?, ?, ?, ?, \\'live\\')');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventKey,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             !empty($event['actor_user_id']) ? (int)$event['actor_user_id'] : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $fileName !== '' ? $fileName : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             wasteImportAuditFormat($event['file_format'] ?? $fileName),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             max(0, (int)($event['valid_row_count'] ?? 0)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             max(0, (int)($event['skipped_row_count'] ?? 0)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $outcome,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $reasonCode !== '' ? $reasonCode : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($eventKey === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return (int)$conn->lastInsertId();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup = $conn->prepare('SELECT id FROM waste_import_events WHERE event_key = ? LIMIT 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup->execute([$eventKey]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return (int)$lookup->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to write waste import audit event: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Record the import outcome before preview metadata is removed. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function logWasteImportBatchOutcome($conn, $batchId, $outcome, $reasonCode = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || trim((string)$batchId) === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('SELECT b.created_by, b.row_count, bf.file_sha256, bf.original_name, bf.row_count AS file_row_count\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             FROM waste_import_batches b\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             LEFT JOIN waste_import_batch_files bf ON bf.batch_id = b.id\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE b.id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$batchId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $files = $stmt->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($files)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($files as $file) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $fileHash = trim((string)($file['file_sha256'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventKey = $outcome === 'imported' && $fileHash !== ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 ? 'manifest:' . $fileHash\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 : 'batch:' . $batchId . ':' . $outcome . ':' . ($fileHash !== '' ? $fileHash : 'summary');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $issueCount = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($fileHash !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCountStmt = $conn->prepare('SELECT COUNT(*) FROM waste_import_batch_issues WHERE batch_id = ? AND source_file_sha256 = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCountStmt->execute([$batchId, $fileHash]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCount = (int)$issueCountStmt->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventId = logWasteImportEvent($conn, [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'event_key' => $eventKey,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'actor_user_id' => $file['created_by'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'original_name' => $file['original_name'] ?? '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'file_format' => $file['original_name'] ?? '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'valid_row_count' => $file['file_row_count'] ?? $file['row_count'] ?? 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'skipped_row_count' => $issueCount,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'outcome' => $outcome,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'reason_code' => $reasonCode,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($eventId > 0 && $fileHash !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $copyIssues = $conn->prepare("INSERT IGNORE INTO waste_import_event_issues (event_id, worksheet_name, source_row_number, reason_code)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     SELECT ?, worksheet_name, source_row_number, reason_code\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     FROM waste_import_batch_issues WHERE batch_id = ? AND source_file_sha256 = ?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $copyIssues->execute([$eventId, $batchId, $fileHash]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to record waste import batch outcome: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function backfillWasteRecordFingerprints($conn, $batchSize = 500)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteImportTables($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $state = $conn->query("SELECT last_record_id FROM waste_import_backfill_state WHERE state_key = 'record_fingerprints'")->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lastRecordId = (int)($state['last_record_id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $processed = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $select = $conn->prepare("SELECT id, collection_date, collection_group, collection_group_type, reporting_period, street, name_of_bioman, households, comply_tue, cd_processing, comply_wed, comply_fri, tuesday_factory_returnable_kg, wednesday_biowaste_kg, thursday_factory_returnable_kg, friday_biowaste_kg, saturday_hazard_waste_kg, residual_waste_kg, unclassified_waste_kg FROM waste_records WHERE id > ? AND is_active = 1 ORDER BY id ASC LIMIT " . max(1, (int)$batchSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $insert = $conn->prepare('INSERT IGNORE INTO waste_record_fingerprints (record_fingerprint) VALUES (?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateRecord = $conn->prepare('UPDATE waste_records SET record_fingerprint = COALESCE(record_fingerprint, ?) WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateState = $conn->prepare("UPDATE waste_import_backfill_state SET last_record_id = ?, completed_at = NULL WHERE state_key = 'record_fingerprints'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     while (true) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $select->execute([$lastRecordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $records = $select->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($records)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $completed = $conn->prepare("UPDATE waste_import_backfill_state SET completed_at = NOW() WHERE state_key = 'record_fingerprints'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $completed->execute();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $fingerprint = buildWasteRecordFingerprint($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $insert->execute([$fingerprint]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $updateRecord->execute([$fingerprint, (int)$record['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $lastRecordId = (int)$record['id'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $processed++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $updateState->execute([$lastRecordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw $e;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $processed;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Create announcement read receipts on demand for existing installations.\par

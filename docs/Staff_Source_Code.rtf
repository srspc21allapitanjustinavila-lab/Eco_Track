\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <?php\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 require_once 'config.php';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 require_once 'includes/waste_analytics.php';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 requireUserType('staff');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Check session timeout\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if (isSessionTimeout()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     logoutUser();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header("Location: login.php?timeout=1");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     exit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $_SESSION['last_activity'] = time();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $user = getCurrentUser();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $conn = getDBConnection();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $wasteDataState = getWasteDataVersion($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Read-only waste overview for staff. No update or delete actions are exposed here.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $staffWasteOverview = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'total_waste' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'returnable' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'biowaste' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'residual' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'hazardous' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'total_records' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     'active_collectors' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $staffDiversionRate = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $staffCategoryDefinitions = getWasteCategoryDefinitions(false);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteFormatColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $newTotalExpr = "COALESCE(tuesday_factory_returnable_kg, 0) + COALESCE(wednesday_biowaste_kg, 0) + COALESCE(thursday_factory_returnable_kg, 0) + COALESCE(friday_biowaste_kg, 0) + COALESCE(saturday_hazard_waste_kg, 0) + COALESCE(residual_waste_kg, 0) + COALESCE(unclassified_waste_kg, 0)";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalExpr = "CASE WHEN ($newTotalExpr) > 0 THEN ($newTotalExpr) ELSE COALESCE(kilogram_of_waste, 0) END";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $returnableExpr = "CASE WHEN (COALESCE(tuesday_factory_returnable_kg, 0) + COALESCE(thursday_factory_returnable_kg, 0)) > 0 THEN (COALESCE(tuesday_factory_returnable_kg, 0) + COALESCE(thursday_factory_returnable_kg, 0)) ELSE COALESCE(recyclable_kg, 0) END";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $biowasteExpr = "COALESCE(wednesday_biowaste_kg, 0) + COALESCE(friday_biowaste_kg, 0)";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $residualExpr = "CASE WHEN COALESCE(residual_waste_kg, 0) > 0 THEN COALESCE(residual_waste_kg, 0) ELSE COALESCE(residual_kg, 0) END";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $hazardousExpr = "CASE WHEN COALESCE(saturday_hazard_waste_kg, 0) > 0 THEN COALESCE(saturday_hazard_waste_kg, 0) ELSE COALESCE(hazardous_kg, 0) END";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $collectorLabelExpr = "COALESCE(NULLIF(name_of_bioman, ''), NULLIF(garbage_collector, ''), 'Unassigned')";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $staffWasteOverviewQuery = $conn->query("SELECT COALESCE(SUM($totalExpr), 0) AS total_waste, COALESCE(SUM($returnableExpr), 0) AS returnable, COALESCE(SUM($biowasteExpr), 0) AS biowaste, COALESCE(SUM($residualExpr), 0) AS residual, COALESCE(SUM($hazardousExpr), 0) AS hazardous, COALESCE(SUM(COALESCE(unclassified_waste_kg, 0)), 0) AS unclassified, COUNT(*) AS total_records, COUNT(DISTINCT NULLIF($collectorLabelExpr, 'Unassigned')) AS active_collectors FROM waste_records WHERE is_active = 1");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $staffWasteOverview = array_merge($staffWasteOverview, $staffWasteOverviewQuery->fetch() ?: []);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categoryTotal = (float)$staffWasteOverview['returnable'] + (float)$staffWasteOverview['biowaste'] + (float)$staffWasteOverview['residual'] + (float)$staffWasteOverview['hazardous'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($categoryTotal > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $staffDiversionRate = round((((float)$staffWasteOverview['returnable'] + (float)$staffWasteOverview['biowaste']) / $categoryTotal) * 100);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // The dashboard remains available even before waste records are set up.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $notificationItems = getNotificationItems($conn, $user);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

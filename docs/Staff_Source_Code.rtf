\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Shared waste calculations for entry, dashboard, heatmap, and reports. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteAnalyticsColumns($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $columns = $conn->query('SHOW COLUMNS FROM waste_records')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $existingColumns = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($columns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $existingColumns[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($existingColumns['collection_date'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_records ADD COLUMN collection_date DATE NULL AFTER date');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($existingColumns['is_active'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_records ADD COLUMN is_active TINYINT(1) NOT NULL DEFAULT 1 AFTER collection_date');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $indexes = $conn->query('SHOW INDEX FROM waste_records')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasCollectionDateIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($indexes as $index) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (($index['Key_name'] ?? '') === 'idx_waste_records_collection_date') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $hasCollectionDateIndex = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasCollectionDateIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('CREATE INDEX idx_waste_records_collection_date ON waste_records (collection_date)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $checked = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to ensure waste analytics columns: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build calendar-day allocations from the authoritative uploaded rows. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteDailyAllocationTable($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("CREATE TABLE IF NOT EXISTS waste_daily_allocations (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             waste_record_id INT NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             allocation_date DATE NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             tuesday_factory_returnable_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             wednesday_biowaste_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             thursday_factory_returnable_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             friday_biowaste_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             saturday_hazard_waste_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             residual_waste_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             unclassified_waste_kg DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             kilogram_of_waste DECIMAL(10,2) NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             PRIMARY KEY (waste_record_id, allocation_date),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INDEX idx_waste_daily_allocations_date (allocation_date)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         )");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $allocationColumns = $conn->query('SHOW COLUMNS FROM waste_daily_allocations')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasUnclassified = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($allocationColumns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (($column['Field'] ?? '') === 'unclassified_waste_kg') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $hasUnclassified = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasUnclassified) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_daily_allocations ADD COLUMN unclassified_waste_kg DECIMAL(10,2) NOT NULL DEFAULT 0 AFTER residual_waste_kg');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $checked = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to ensure waste daily allocations table: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteNumericValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return is_numeric($value) ? (float)$value : 0.0;\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['label' => 'High', 'color' => '#d32f2f', 'color_name' => 'Red', 'slug' => 'high'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

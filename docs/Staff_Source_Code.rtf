\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     function toggleNotificationMenu(event, button) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       event.stopPropagation();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const control = button.closest(".notification-control");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const open = control.classList.toggle("is-open");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       button.setAttribute("aria-expanded", open ? "true" : "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     document.addEventListener("click", function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       document.querySelectorAll(".notification-control.is-open").forEach(function (control) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         control.classList.remove("is-open");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const button = control.querySelector(".notification-toggle");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (button) button.setAttribute("aria-expanded", "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     document.addEventListener("keydown", function (event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (event.key !== "Escape") return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       document.querySelectorAll(".notification-control.is-open").forEach(function (control) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         control.classList.remove("is-open");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const button = control.querySelector(".notification-toggle");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (button) button.setAttribute("aria-expanded", "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     (function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const script = document.currentScript;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const control = script ? script.previousElementSibling : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (!control) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const button = control.querySelector(".notification-toggle");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const badge = () => control.querySelector(".notification-badge");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const menuItems = control.querySelector(".notification-menu-items");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       function notificationLabel(count) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return count\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           ? "Open notifications, " + count + " unread notification" + (count === 1 ? "" : "s")\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           : "Open notifications";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       function setBadge(count) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         count = Math.max(0, Number(count) || 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         button.setAttribute("aria-label", notificationLabel(count));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         let countBadge = badge();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!count) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (countBadge) countBadge.remove();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!countBadge) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           countBadge = document.createElement("span");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           countBadge.className = "notification-badge";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           countBadge.setAttribute("aria-hidden", "true");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           button.appendChild(countBadge);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         countBadge.textContent = count > 9 ? "9+" : String(count);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildDssRecommendations($phaseTotals, $phaseBands, $limit = 3)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $nextMonday = new DateTimeImmutable('monday next week');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recommendations = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($phaseTotals as $phase) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (wasteNumericValue($phase['total_waste'] ?? 0) <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $level = $phase['waste_level'] ?? classifyWasteTotal($phase['total_waste'], $phaseBands);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($level['label'] === 'High') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $dayOffsets = [0, 2, 4];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} elseif ($level['label'] === 'Medium-High') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $dayOffsets = [1, 4];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $dayOffsets = [3];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $days = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($dayOffsets as $offset) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $days[] = $nextMonday->modify('+' . $offset . ' days')->format('l, M j');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

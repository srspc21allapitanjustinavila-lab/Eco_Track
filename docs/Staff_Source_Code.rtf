\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['reset_preferences'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $defaults = getDefaultUserSettings();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updatedSettings = $currentSettings;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (['reports_reminder', 'high_waste_alerts'] as $preferenceKey) \{\par

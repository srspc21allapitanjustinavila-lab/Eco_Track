\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildHeatmapDssMetric($total, $recordIds, $dayCount, $previousTotal, $previousRecordIds, $previousDayCount)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $hasData = !empty($recordIds);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $hasPreviousData = !empty($previousRecordIds);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $dailyAverage = $hasData ? round(wasteNumericValue($total) / max(1, $dayCount), 2) : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $previousAverage = $hasPreviousData ? round(wasteNumericValue($previousTotal) / max(1, $previousDayCount), 2) : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $classification = classifyDailyWasteAverage($dailyAverage, $hasData);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $success = $hasData && $hasPreviousData && $classification['slug'] === 'low' && $dailyAverage < $previousAverage;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $dssStatus = !$hasData ? 'no-data' : (!$hasPreviousData ? 'no-baseline' : ($success ? 'success' : ($dailyAverage >= $previousAverage ? 'not-reduced' : 'not-low')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par

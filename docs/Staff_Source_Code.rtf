\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return strcasecmp($left['phase_name'] . ' ' . $left['street'], $right['phase_name'] . ' ' . $right['street']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_slice($comparison, 0, max(0, (int)$limit));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

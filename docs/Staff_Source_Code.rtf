\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $updatedSettings['high_waste_alerts'] = settingToggleValue($highWasteAlerts);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (saveUserSettings($conn, $user_id, $updatedSettings)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $_SESSION['theme'] = $submittedTheme;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $currentSettings = $updatedSettings;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             applyUserSettingsToSession($currentSettings);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $message = "Preferences saved successfully!";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             logActivity('Updated system preferences', 'Settings', 'Success', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $error = "Failed to save preferences.";\par

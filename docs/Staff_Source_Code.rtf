\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Resolve a chartable category breakdown for one record.  Older rows can have\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * only a legacy total, so preserve that amount as unclassified rather than\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * showing a total bar with no visible stacked segment.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteRecordStreetCategoryBreakdown($record, array $definitions)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categories = array_fill_keys(array_keys($definitions), 0.0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $knownTotal = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($categories as $category => $unused) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $amount = max(0.0, wasteRecordCategoryKg($record, $category));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categories[$category] = $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $knownTotal += $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $effectiveTotal = max(0.0, wasteRecordEffectiveKg($record));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (array_key_exists('unclassified', $categories) && $effectiveTotal > $knownTotal) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categories['unclassified'] += $effectiveTotal - $knownTotal;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $knownTotal = $effectiveTotal;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'categories' => $categories,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Detailed category fields are more specific than an incomplete\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // legacy total, while still retaining a larger legacy total above.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'total_waste' => max($effectiveTotal, $knownTotal),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteStreetComparisonKey($phaseName, $street)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return hash('sha256', strtolower(trim((string)$phaseName)) . "\\x1F" . strtolower(trim((string)$street)));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Normalize the Street chart's Phase, category, and inclusive exact-date bounds. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteStreetFilters(array $filters, array $definitions = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var dailyPanel = form.querySelector('[data-heatmap-mode-panel="daily"]');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var monthPanel = form.querySelector('[data-heatmap-mode-panel="month"]');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var yearPanel = form.querySelector('[data-heatmap-mode-panel="year"]');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var dateInputs = dailyPanel.querySelectorAll('input[type="date"]');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var monthInput = document.getElementById('heatmapMonth');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var yearInput = document.getElementById('heatmapYear');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         var submitButton = form.querySelector('.heatmap-period-submit');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function selectedHeatmapMode() \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var selectedInput = form.querySelector('input[name="mode"]:checked');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           return selectedInput ? selectedInput.value : 'daily';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function syncPicker(input) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (window.EcoTrackYearPicker) window.EcoTrackYearPicker.sync(input);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function setHeatmapMode(mode) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isDaily = mode === 'daily';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isMonthly = mode === 'month';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isYearly = mode === 'year';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           dailyPanel.hidden = !isDaily;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           monthPanel.hidden = !isMonthly;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           yearPanel.hidden = !isYearly;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           viewInput.value = isDaily ? 'week' : mode;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           dateInputs.forEach(function (input) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             input.disabled = !isDaily;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             input.required = isDaily;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             syncPicker(input);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           monthInput.disabled = !isMonthly;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           monthInput.required = isMonthly;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           syncPicker(monthInput);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var hasAvailableYear = Array.prototype.some.call(yearInput.options, function (option) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return option.value !== '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           yearInput.disabled = !isYearly || !hasAvailableYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           yearInput.required = isYearly && !yearInput.disabled;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           submitButton.textContent = isMonthly ? 'Apply month' : (isYearly ? 'Apply year' : 'Apply dates');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           submitButton.disabled = isYearly && !hasAvailableYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           modeInputs.forEach(function (input) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             input.closest('.heatmap-mode-option').classList.toggle('is-selected', input.checked);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         modeInputs.forEach(function (input) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           input.addEventListener('change', function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (input.checked) setHeatmapMode(input.value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         document.addEventListener('ecotrackyearpickerready', function () \{\par

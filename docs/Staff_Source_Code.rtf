\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'has_data' => $hasData,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'daily_average_kg' => $dailyAverage,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'previous_total_waste' => $hasPreviousData ? round(wasteNumericValue($previousTotal), 2) : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'previous_daily_average_kg' => $previousAverage,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'change_kg_per_day' => $hasPreviousData ? round($dailyAverage - $previousAverage, 2) : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'classification' => $classification,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'dss' => ['status' => $dssStatus, 'success' => $success],\par

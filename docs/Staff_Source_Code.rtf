\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif ($endDate !== null && $startDate === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $startDate = $endDate;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startDate !== null && $endDate !== null && $startDate > $endDate) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         [$startDate, $endDate] = [$endDate, $startDate];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par

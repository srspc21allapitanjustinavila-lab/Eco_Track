\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function calculateWasteBands($values)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $positiveValues = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($values as $value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $value = wasteNumericValue($value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($value > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $positiveValues[] = $value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     sort($positiveValues, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $uniqueValues = array_values(array_unique(array_map(static function ($value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return sprintf('%.10F', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}, $positiveValues)));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $uniqueCount = count($uniqueValues);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bands = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'has_data' => !empty($positiveValues),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'mode' => 'empty',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'min' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'max' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'q1' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'q2' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'q3' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($positiveValues)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $bands;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bands['min'] = $positiveValues[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bands['max'] = $positiveValues[count($positiveValues) - 1];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($uniqueCount === 1) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['mode'] = 'homogeneous';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['q1'] = $bands['q2'] = $bands['q3'] = $bands['min'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $bands;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($uniqueCount < 4) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['mode'] = 'range';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $width = ($bands['max'] - $bands['min']) / 4;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['q1'] = $bands['min'] + $width;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['q2'] = $bands['min'] + ($width * 2);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands['q3'] = $bands['min'] + ($width * 3);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $bands;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bands['mode'] = 'quartile';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $count = count($positiveValues);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ([1 => 'q1', 2 => 'q2', 3 => 'q3'] as $quartile => $key) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $index = max(0, (int)ceil(($count * $quartile) / 4) - 1);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bands[$key] = $positiveValues[$index];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $bands;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function classifyWasteTotal($totalWaste, $bands)\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $startDate = normalizeWasteDateValue($filters['start_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $endDate = normalizeWasteDateValue($filters['end_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startDate !== null && $endDate === null) \{\par

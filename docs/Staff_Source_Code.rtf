\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return preg_match('/^(19|20)\\\\d\{2\}-(0[1-9]|1[0-2])$/', $value) ? $value : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Convert one or two selected Street months into inclusive database dates.\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $category = strtolower(trim((string)($filters['category'] ?? 'all')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($category !== 'all' && !isset($definitions[$category])) \{\par

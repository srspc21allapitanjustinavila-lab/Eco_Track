\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <?php\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 require_once 'config.php';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 requireUserType('staff');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Check session timeout\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if (isSessionTimeout()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     logoutUser();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header("Location: login.php?timeout=1");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     exit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $_SESSION['last_activity'] = time();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $user = getCurrentUser();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $conn = getDBConnection();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 ensureNotificationsTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $message = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $error = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Handle task completion\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['complete_task'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $task_id = intval($_POST['task_id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $taskLookup = $conn->prepare('SELECT title, created_by FROM daily_tasks WHERE id = ? AND assigned_to = ? AND status = \\'pending\\' LIMIT 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $taskLookup->execute([$task_id, $user['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $task = $taskLookup->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare("UPDATE daily_tasks SET status = 'completed', completed_at = NOW(), completed_by = ? WHERE id = ? AND assigned_to = ? AND status = 'pending'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$user['id'], $task_id, $user['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($stmt->rowCount() === 1) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $staffName = trim(($user['first_name'] ?? '') . ' ' . ($user['last_name'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($staffName === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $staffName = $user['username'] ?? 'A staff member';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!empty($task['created_by'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 createUserNotification(\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $conn,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $task['created_by'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     'Task completed',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $staffName . ' completed: ' . ($task['title'] ?? 'an assigned task'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     'admin_dashboard.php',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     'task_completed',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $user['id']\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 );\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $taskTitle = trim((string)($task['title'] ?? 'an assigned task'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             logActivity('Completed daily task: ' . substr($taskTitle, 0, 110), 'Daily Tasks', 'Success', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $message = "Task marked as completed!";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $error = "This task is no longer available to complete.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             logActivity('Completed daily task', 'Daily Tasks', 'Failed', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "Failed to update task.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         logActivity('Completed daily task', 'Daily Tasks', 'Failed', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Show all tasks assigned to this staff member. Pending tasks from earlier\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // dates remain visible until the staff member completes them.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $tasks = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $completed_count = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $pending_count = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $cancelled_count = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $conn->prepare("SELECT * FROM daily_tasks WHERE assigned_to = ? ORDER BY FIELD(status, 'pending', 'completed', 'cancelled'), FIELD(priority, 'high', 'normal', 'low'), task_date DESC, created_at DESC");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt->execute([$user['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $tasks = $stmt->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($tasks as $task) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($task['status'] == 'completed') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $completed_count++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} elseif ($task['status'] == 'cancelled') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $cancelled_count++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $pending_count++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $error = "Failed to load tasks.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $notificationItems = getNotificationItems($conn, $user);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 ?>\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build the highest-record Collection Group and Area comparison. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildPhaseStreetRecordComparison($records, $limit = 6)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $areas = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = normalizeWastePhaseLabel($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $totalWaste = wasteRecordEffectiveKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $street = trim(preg_replace('/\\s+/u', ' ', (string)($record['street'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $streetLabel = $street !== '' ? $street : 'Unassigned street';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $areaKey = strtolower($phaseName . "\\x1F" . $streetLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($areas[$areaKey]) || $totalWaste > $areas[$areaKey]['total_waste']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $areas[$areaKey] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_name' => $phaseName,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'street' => $streetLabel,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'period_label' => wasteRecordReportingPeriodLabel($record),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'total_waste' => $totalWaste,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'record_count' => 1,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $comparison = array_values($areas);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     usort($comparison, static function ($left, $right) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $difference = (float)$right['total_waste'] <=> (float)$left['total_waste'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($difference !== 0) \{\par

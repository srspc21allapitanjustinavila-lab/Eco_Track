\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWastePhaseLabel($record)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Preserve non-phase groups such as Establishments before legacy fallbacks.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $collectionGroup = trim((string)($record['collection_group'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($collectionGroup !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return wasteAnalyticsCollectionGroupFromLegacyLabel($collectionGroup);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $source = wasteRecordPhaseSource($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phase = wasteAnalyticsPhaseGroupFromLabel($source);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($phase !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $phase;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $street = trim((string)($record['street'] ?? ''));\par

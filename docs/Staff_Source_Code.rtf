\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         unset($phase['record_ids']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($phase);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     usort($phaseTotals, static function ($left, $right) \{\par

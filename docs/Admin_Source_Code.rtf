\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function parsePdfUpload($path)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $pdf = file_get_contents($path);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($pdf === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('Could not read the PDF file.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // EcoTrack exports uncompressed text streams. Reading those streams lets a\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // downloaded EcoTrack PDF be imported again without an external PDF library.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     preg_match_all('/\\\\((?:\\\\\\\\.|[^\\\\\\\\)])*\\\\)\\\\s*Tj/', $pdf, $matches);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $values = array_map(static function ($match) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return pdfTextValue(substr($match, 1, -3));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}, $matches[0]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $columnCount = count(getWasteFormatHeaders());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (count($values) < $columnCount + 3) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('This PDF has no readable table data. Use a text-based EcoTrack PDF; scanned PDFs need to be converted to CSV or Excel first.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Start after every page header so multi-page EcoTrack downloads can also be\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // imported. Older downloads say "Name of Bi..."; the current layout says\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // "Bioman".\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $rows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     for ($i = 0; $i < count($values); $i++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (stripos($values[$i], 'Name of Bi') !== 0 && stripos($values[$i], 'Bioman') !== 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $pageValues = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         for ($j = $i + $columnCount; $j < count($values); $j++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (stripos($values[$j], 'EcoTrack Waste Data Export') === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $pageValues[] = $values[$j];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (array_chunk($pageValues, $columnCount) as $row) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (count($row) === $columnCount && rowHasData($row) && !isWasteSummaryRow($row)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $rows[] = $row;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($rows)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('No importable rows were found in this PDF.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [getWasteFormatHeaders(), $rows, ''];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

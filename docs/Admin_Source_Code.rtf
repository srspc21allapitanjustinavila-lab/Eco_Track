\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stagedRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $flushStagedRows = static function () use (&$stagedRows, $conn, $stagingPrefix, $rowPlaceholder) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Find a high-confidence one- or two-row header at an arbitrary worksheet row. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function detectWasteHeaderAt($rows, $rowIndex)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $row = $rows[$rowIndex] ?? [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!rowHasData($row)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $candidates = [['headers' => $row, 'height' => 1]];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $next = $rows[$rowIndex + 1] ?? [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (rowHasData($next)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $candidates[] = ['headers' => mergeWasteHeaderRows($row, $next), 'height' => 2];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $best = null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bestScore = -1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($candidates as $candidate) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $profile = getWasteImportHeaderProfile($candidate['headers']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$profile['is_high_confidence']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $score = count($profile['column_map'])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             + ($profile['long_format_columns']['type'] === null ? 0 : 1)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             + ($profile['long_format_columns']['amount'] === null ? 0 : 1);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Prefer one-row headers when confidence scores tie.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($score > $bestScore || ($score === $bestScore && $best !== null && $candidate['height'] < $best['height'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $candidate['profile'] = $profile;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $best = $candidate;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $bestScore = $score;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $best;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function parseExcelWorksheetBlocks($rows, $sheetName, $fileLabel = '', $sourceRowNumbers = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentHeaders = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentPhaseLabel = buildWasteWorksheetSourceLabel($sheetName, '', $fileLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $importRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseLabels = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $blockRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $blockRowLabels = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $blockSourceRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $flushBlock = static function () use (&$blockRows, &$blockRowLabels, &$blockSourceRows, &$importRows, &$phaseLabels, &$sourceRows, &$currentPhaseLabel) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (fillMissingBiomanNames($blockRows) as $index => $row) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $importRows[] = $row;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phaseLabels[] = $blockRowLabels[$index] ?? $currentPhaseLabel;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $sourceRows[] = $blockSourceRows[$index] ?? 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $blockRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $blockRowLabels = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $blockSourceRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \};\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     for ($rowIndex = 0; $rowIndex < count($rows); $rowIndex++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $row = $rows[$rowIndex];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!rowHasData($row)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $blockLabel = getWasteWorksheetBlockLabel($row);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($blockLabel !== null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $flushBlock();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $currentPhaseLabel = buildWasteWorksheetSourceLabel($sheetName, $blockLabel, $fileLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Require a confident new block while supporting split header rows.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $headerCandidate = detectWasteHeaderAt($rows, $rowIndex);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($headerCandidate !== null && !empty($currentHeaders) && isset($headerCandidate['profile']['column_map'][2])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // A fresh Household heading starts a separate table.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $flushBlock();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $currentHeaders = $headerCandidate['headers'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $rowIndex += $headerCandidate['height'] - 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($headerCandidate !== null || (!empty($currentHeaders) && hasRecognizedWasteHeaderFields($row))) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($headerCandidate !== null && empty($currentHeaders)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $currentHeaders = $headerCandidate['headers'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $rowIndex += $headerCandidate['height'] - 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $headerMap = getWasteImportColumnMap($row);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $isSplitHeader = !empty($currentHeaders) && count($headerMap) < count(getWasteFormatHeaders());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!$isSplitHeader) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $currentHeaders = $row;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Merge recognized lower-row headers in split workbook layouts.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $longFormatColumns = getWasteImportLongFormatColumns($row);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $recognizedHeaderColumns = array_values($headerMap);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach ([$longFormatColumns['type'], $longFormatColumns['amount'], getWasteImportPeriodColumn($row)] as $sourceIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if ($sourceIndex !== null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $recognizedHeaderColumns[] = $sourceIndex;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach (array_unique($recognizedHeaderColumns) as $sourceIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $currentHeaders[$sourceIndex] = $row[$sourceIndex] ?? '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $row[$sourceIndex] = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Do not carry old categories into reused calculated-value columns.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach ($row as $sourceIndex => $headerValue) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if (trim((string)$headerValue) !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $currentHeaders[$sourceIndex] = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Keep left-side record cells that share a lower split-header row.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!rowHasData($row)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($currentHeaders) || isWasteTotalRow($row)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par

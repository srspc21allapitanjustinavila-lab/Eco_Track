\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offsetStmt = $conn->prepare('SELECT COALESCE(MAX(row_number), 0) FROM waste_import_staging_rows WHERE batch_id = ?');\par

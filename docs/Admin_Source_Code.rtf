\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build shared weekly visualization data after records are fetched. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function yearlyWasteTrendBuckets($year, $view)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = (int)$year;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearStart = new DateTimeImmutable(sprintf('%04d-01-01', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearEnd = $yearStart->setDate($year, 12, 31);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $buckets = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'week') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $yearStart;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $week = 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         while ($start <= $yearEnd) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $end = $start->modify('+6 days');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($end > $yearEnd) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $end = $yearEnd;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $buckets[] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'period' => $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'label' => 'Week ' . $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'start' => $start->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'end' => $end->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'range' => $start->format('M j') . '\u8211?' . $end->format('M j'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'event_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'records' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_label' => 'No collection',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $start = $start->modify('+7 days');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $week++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $buckets;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     for ($month = 1; $month <= 12; $month++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $yearStart->setDate($year, $month, 1);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = $start->modify('last day of this month');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $buckets[] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'period' => $month,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'label' => $start->format('M'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'start' => $start->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'end' => $end->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'range' => $start->format('M j') . '\u8211?' . $end->format('j'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'event_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'records' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'phase_label' => 'No collection',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $buckets;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWeeklyWasteTrendAnalysis($records, $filters)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = ($filters['view'] ?? 'month') === 'week' ? 'week' : 'month';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = (int)$filters['year'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $buckets = yearlyWasteTrendBuckets($year, $view);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bucketIndexes = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($buckets as $index => $bucket) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bucketIndexes[(int)$bucket['period']] = $index;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearStart = new DateTimeImmutable(sprintf('%04d-01-01', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!weeklyWasteTrendIsActiveRecord($record)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $date = weeklyWasteTrendRecordDate($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($date === null || (int)substr($date, 0, 4) !== $year) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $location = weeklyWasteTrendLocationDescriptor($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (($filters['location'] ?? '') !== '' && $location['key'] !== $filters['location'] && $location['group_key'] !== $filters['location']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($view === 'week') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $recordDate = new DateTimeImmutable($date);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $period = intdiv($yearStart->diff($recordDate)->days, 7) + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $period = (int)substr($date, 5, 2);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($bucketIndexes[$period])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bucketIndex = $bucketIndexes[$period];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $buckets[$bucketIndex]['total_waste'] += wasteRecordEffectiveKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $buckets[$bucketIndex]['event_count']++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $buckets[$bucketIndex]['records'][] = $record;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($buckets as &$bucket) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseNames = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $streetNames = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($bucket['records'] as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phaseName = trim(normalizeWastePhaseLabel($record));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($phaseName !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $phaseNames[$phaseName] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $streetName = trim(preg_replace('/\\s+/u', ' ', (string)($record['street'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($streetName !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $streetNames[$streetName] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseNames = array_keys($phaseNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $streetNames = array_keys($streetNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         natcasesort($phaseNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         natcasesort($streetNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $streetNames = array_values($streetNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bucket['phase_label'] = !empty($phaseNames) ? implode(', ', $phaseNames) : 'No collection';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bucket['street_names'] = $streetNames;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bucket['street_label'] = weeklyWasteTrendSummaryList($streetNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($bucket);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalWaste = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $eventCount = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($buckets as $bucket) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $totalWaste += (float)$bucket['total_waste'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $eventCount += (int)$bucket['event_count'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $highestPeriod = $buckets[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lowestPeriod = $buckets[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($buckets as $bucket) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)$bucket['total_waste'] > (float)$highestPeriod['total_waste']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $highestPeriod = $bucket;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)$bucket['total_waste'] < (float)$lowestPeriod['total_waste']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $lowestPeriod = $bucket;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'filters' => $filters,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'weeks' => $buckets,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'all_weeks' => $buckets,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'total_waste' => $totalWaste,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'event_count' => $eventCount,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'highest_week' => $highestPeriod,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'lowest_week' => $lowestPeriod,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'average_weekly_waste' => !empty($buckets) ? $totalWaste / count($buckets) : 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'description' => describeWeeklyWasteTrend($buckets, $view),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'description_tl' => describeWeeklyWasteTrend($buckets, $view, 'tl'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function weeklyWasteTrendPreservedParams($request)\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($fileHeaders)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $fileName = trim((string)($file['name'] ?? 'The uploaded file'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $errorMessage = $fileName . ' does not contain recognizable Waste Data rows. Check the column headings and try again.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($fileType === 'xlsx' && !empty($worksheetSummary['worksheets'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $worksheetMessages = [];\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function heatmapPeriodBounds($view, $period)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = normalizeHeatmapPeriodView($view);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $period = trim((string)$period);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'week' && preg_match('/^((?:19|20)\\d\{2\})-W(\\d\{2\})$/', $period, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $year = (int)$matches[1];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $week = (int)$matches[2];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $yearStart = new DateTimeImmutable(sprintf('%04d-01-01', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $maxWeek = intdiv((int)$yearStart->format('z') + 365, 7) + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($week >= 1 && $week <= $maxWeek) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return heatmapPeriodBoundsForDate('week', $yearStart->modify('+' . (($week - 1) * 7) . ' days'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'month' && preg_match('/^((?:19|20)\\d\{2\})-(0[1-9]|1[0-2])$/', $period)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return heatmapPeriodBoundsForDate('month', $period . '-01');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'year' && preg_match('/^(?:19|20)\\d\{2\}$/', $period)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return heatmapPeriodBoundsForDate('year', $period . '-01-01');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

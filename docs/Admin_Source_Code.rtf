\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function shiftIsoDate(value, days) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (!/^\\d\{4\}-\\d\{2\}-\\d\{2\}$/.test(value || '')) return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var parts = value.split('-');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var date = new Date(Date.UTC(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           date.setUTCDate(date.getUTCDate() + days);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           return date.toISOString().slice(0, 10);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

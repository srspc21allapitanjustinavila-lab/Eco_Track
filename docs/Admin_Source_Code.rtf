\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $sourceRows;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Build Phase choices and date availability from the same active,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * fingerprint-safe source data as the Street chart. Availability deliberately\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * ignores its own range so either bound can be changed without trapping users.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteStreetFilterState(array $records, array $filters = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $definitions = getWasteStreetCategoryDefinitions();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filters = normalizeWasteStreetFilters($filters, $definitions);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceRows = buildWasteStreetSourceRows($records, $definitions);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseMap = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $hasUnclassified = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($sourceRows as $sourceRow) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseMap[strtolower($sourceRow['phase_name'])] = $sourceRow['phase_name'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)($sourceRow['breakdown']['categories']['unclassified'] ?? 0) > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasUnclassified = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseOptions = array_values($phaseMap);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     natcasesort($phaseOptions);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseOptions = array_values($phaseOptions);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($filters['phase'] !== '' && !in_array($filters['phase'], $phaseOptions, true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $filters['phase'] = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($filters['category'] === 'unclassified' && !$hasUnclassified) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $filters['category'] = 'all';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $availableMonthsByYear = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $availableDatesByMonth = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($sourceRows as $sourceRow) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($filters['phase'] !== '' && $sourceRow['phase_name'] !== $filters['phase']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $amount = $filters['category'] === 'all'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? (float)$sourceRow['breakdown']['total_waste']\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : (float)($sourceRow['breakdown']['categories'][$filters['category']] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $date = $sourceRow['collection_date'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($amount <= 0 || $date === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $availableMonthsByYear[substr($date, 0, 4)][(int)substr($date, 5, 2)] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $availableDatesByMonth[substr($date, 0, 7)][$date] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     krsort($availableMonthsByYear, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $calendarYears = array_keys($availableMonthsByYear);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     rsort($calendarYears, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($availableMonthsByYear as &$months) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $months = array_keys($months);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         rsort($months, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($months);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     krsort($availableDatesByMonth, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($availableDatesByMonth as &$dates) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $dates = array_keys($dates);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         rsort($dates, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($dates);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'filters' => $filters,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'definitions' => $definitions,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'has_unclassified' => $hasUnclassified,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'phase_options' => $phaseOptions,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'calendar' => [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'years' => array_map('intval', $calendarYears),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'months_by_year' => $availableMonthsByYear,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'dates_by_month' => $availableDatesByMonth,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'source_rows' => $sourceRows,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Build the server-calculated drill-down payload for one displayed Phase +\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Street row. The row has already passed the same active-record, date, Phase,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * category, and fingerprint rules as the chart, so its values cannot drift\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * from the corresponding stacked bar.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteStreetDetailPayload(array $row, array $filters, array $definitions)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categoryFilter = $filters['category'] ?? 'all';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categoryKeys = $categoryFilter === 'all' ? array_keys($definitions) : [$categoryFilter];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categoryAmounts = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalWaste = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($categoryKeys as $categoryKey) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($definitions[$categoryKey])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $amount = max(0.0, (float)($row['categories'][$categoryKey] ?? 0));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // The established Unclassified category exists only to account for\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // legacy totals. Do not introduce it to a detail view when it is not\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // needed to reconcile the actual total.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($categoryKey === 'unclassified' && $amount <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categoryAmounts[$categoryKey] = $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $totalWaste += $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categories = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($categoryAmounts as $categoryKey => $amount) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categories[$categoryKey] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'label' => $definitions[$categoryKey]['label'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'color' => $definitions[$categoryKey]['color'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'amount' => $amount,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'percent' => $totalWaste > 0 ? ($amount / $totalWaste) * 100 : 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'key' => $row['key'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'phase_name' => $row['phase_name'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'street' => $row['street'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'record_count' => (int)($row['record_count'] ?? 0),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'first_date' => $row['first_date'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'last_date' => $row['last_date'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Sum the displayed categories so this always reconciles with the\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // category breakdown, including selected-category-only views.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'total_waste' => $totalWaste,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'categories' => $categories,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Build a filterable, summed phase/street dataset. Unlike the legacy comparison\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * this retains every Phase + Street identity and adds every matching record.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteStreetComparison(array $records, array $filters = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filterState = buildWasteStreetFilterState($records, $filters);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $definitions = $filterState['definitions'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filters = $filterState['filters'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseFilter = $filters['phase'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categoryFilter = $filters['category'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $startDate = $filters['start_date'] ?: null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $endDate = $filters['end_date'] ?: null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $areas = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($filterState['source_rows'] as $sourceRow) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = $sourceRow['phase_name'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $street = $sourceRow['street'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collectionDate = $sourceRow['collection_date'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($phaseFilter !== '' && $phaseName !== $phaseFilter) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (($startDate !== null && ($collectionDate === null || $collectionDate < $startDate)) || ($endDate !== null && ($collectionDate === null || $collectionDate > $endDate))) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $key = $sourceRow['key'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($areas[$key])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $areas[$key] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'key' => $key,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_name' => $phaseName,\par

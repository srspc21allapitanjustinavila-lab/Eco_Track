\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function heatmapPeriodBoundsForDate($view, $date)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = normalizeHeatmapPeriodView($view);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $date = $date instanceof DateTimeInterface ? DateTimeImmutable::createFromInterface($date) : new DateTimeImmutable($date);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = (int)$date->format('Y');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'year') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = new DateTimeImmutable(sprintf('%04d-01-01', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = new DateTimeImmutable(sprintf('%04d-12-31', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['view' => 'year', 'period' => (string)$year, 'start' => $start->format('Y-m-d'), 'end' => $end->format('Y-m-d'), 'label' => (string)$year];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'month') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $date->modify('first day of this month');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = $date->modify('last day of this month');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['view' => 'month', 'period' => $start->format('Y-m'), 'start' => $start->format('Y-m-d'), 'end' => $end->format('Y-m-d'), 'label' => $start->format('F Y')];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearStart = new DateTimeImmutable(sprintf('%04d-01-01', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $week = intdiv((int)$yearStart->diff($date)->days, 7) + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $start = $yearStart->modify('+' . (($week - 1) * 7) . ' days');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearEnd = new DateTimeImmutable(sprintf('%04d-12-31', $year));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $end = $start->modify('+6 days');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($end > $yearEnd) \{\par

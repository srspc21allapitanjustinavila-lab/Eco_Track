\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isValidSettingToggle($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return in_array((string)$value, ['0', '1'], true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeActivityLogYear($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return preg_match('/^(?:19|20)\\d\{2\}$/', $value) ? $value : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeActivityLogRole($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = strtolower(trim((string)$value));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return in_array($value, ['admin', 'staff'], true) ? ucfirst($value) : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Handle Change Password\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['change_password'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $current_password = trim($_POST['current_password'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $new_password = trim($_POST['new_password'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $confirm_password = trim($_POST['confirm_password'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($current_password) || empty($new_password) || empty($confirm_password)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "Please fill in all password fields.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif ($new_password !== $confirm_password) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "New passwords do not match.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif (strlen($new_password) < 6) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "Password must be at least 6 characters.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stmt = $conn->prepare("SELECT password_hash FROM users WHERE id = ?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stmt->execute([$user_id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $user = $stmt->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($user && password_verify($current_password, $user['password_hash'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $new_hash = password_hash($new_password, PASSWORD_DEFAULT);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if (!ensurePersistentLoginTokensTable($conn)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     throw new RuntimeException('Unable to prepare remembered login storage.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $stmt = $conn->prepare("UPDATE users SET password_hash = ? WHERE id = ?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $stmt->execute([$new_hash, $user_id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if (!revokePersistentLoginsForUser($conn, $user_id)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     throw new RuntimeException('Unable to revoke remembered logins.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 logActivity('Changed password', 'Settings', 'Success', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 logoutUser();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 header('Location: login.php?password=changed');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 exit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $error = "Current password is incorrect.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 logActivity('Changed password', 'Settings', 'Failed', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($conn && $conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $error = "Failed to change password.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             logActivity('Changed password', 'Settings', 'Failed', $conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

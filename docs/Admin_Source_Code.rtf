\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $username = trim($_POST['username'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $email = trim($_POST['email'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $first_name = trim($_POST['first_name'] ?? '');\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var hasAvailableYear = Array.prototype.some.call(yearInput.options, function (option) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return option.value !== '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           yearInput.disabled = !isYearly || !hasAvailableYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           yearInput.required = isYearly && !yearInput.disabled;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (isDaily) setDailyWeekFromStart();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (window.EcoTrackYearPicker) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             dateInputs.forEach(function (input) \{ window.EcoTrackYearPicker.sync(input); \});\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $endDay = min($week * 7, $lastDay);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($startDay > $lastDay) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Keep five chart positions for every month, including empty Week 5 slots.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $buckets[] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'week' => $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'label' => 'Week ' . $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'start' => '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'end' => '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'range' => 'No calendar days',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'event_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'records' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_label' => 'No collection',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $periodStart->setDate((int)$year, (int)$month, $startDay);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = $periodStart->setDate((int)$year, (int)$month, $endDay);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $buckets[] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'week' => $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'label' => 'Week ' . $week,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'start' => $start->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'end' => $end->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'range' => $start->format('M j') . '\u8211?' . $end->format('j'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'event_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'records' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'phase_label' => 'No collection',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $buckets;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

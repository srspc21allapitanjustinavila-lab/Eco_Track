\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteImportDatasetHash($fingerprints)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fingerprints = array_values(array_unique(array_filter($fingerprints, static function ($value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return trim((string)$value) !== '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \})));\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $top = trim((string)($topRow[$index] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bottom = trim((string)($bottomRow[$index] ?? ''));\par

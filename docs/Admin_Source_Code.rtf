\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeImportWasteAmount($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (in_array($value, ['', '-', '\u8211?', '\u8212?', 'N/A', 'n/a'], true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Accept units and non-breaking spaces, but reject other numeric text.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = preg_replace('/\\x\{00A0\}/u', ' ', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = preg_replace('/\\s*(?:kgs?|kilograms?)\\s*$/i', '', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return str_replace([',', ' '], '', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

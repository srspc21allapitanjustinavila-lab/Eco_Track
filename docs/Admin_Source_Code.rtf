\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $fingerprint) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     $known[$fingerprint] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $rows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($payload['records'] as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (isset($known[$record['record_fingerprint']])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $payload['skipped_existing_rows']++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $known[$record['record_fingerprint']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $rows[] = $record;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $payload['records'] = $rows;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($payload);\par

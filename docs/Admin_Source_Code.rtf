\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("INSERT IGNORE INTO waste_import_events\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             (event_key, actor_user_id, original_name, file_format, valid_row_count, skipped_row_count, outcome, reason_code, event_source, created_at)\par

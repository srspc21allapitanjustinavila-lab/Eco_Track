\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function setDssMode(mode) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isDaily = mode === 'daily';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isMonthly = mode === 'month';\par

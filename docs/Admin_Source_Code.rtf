\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function fetchDssPeriodAnalytics($conn, $view, $period = '', $startDate = '', $endDate = '', $collectionGroup = '', $allowEmptyRequestedPeriod = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Keep staff assignments from one posted task addressable as a single batch. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureDailyTaskBatching($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $taskTable = $conn->query("SHOW TABLES LIKE 'daily_tasks'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$taskTable || $taskTable->rowCount() === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $columns = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($conn->query('SHOW COLUMNS FROM daily_tasks')->fetchAll() as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $columns[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($columns['task_batch_id'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE daily_tasks ADD COLUMN task_batch_id CHAR(32) NULL AFTER id');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $batchIndex = $conn->query("SHOW INDEX FROM daily_tasks WHERE Key_name = 'idx_daily_tasks_batch'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$batchIndex || $batchIndex->rowCount() === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE daily_tasks ADD INDEX idx_daily_tasks_batch (task_batch_id)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Older task posts created one row per staff member without a shared ID.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Copies created by the same post have identical author, timestamp, date, and content.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $legacyBatches = $conn->query("SELECT created_by, created_at, task_date, title, description, priority\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             FROM daily_tasks\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE task_batch_id IS NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             GROUP BY created_by, created_at, task_date, title, description, priority");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $assignBatch = $conn->prepare('UPDATE daily_tasks SET task_batch_id = ?\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE task_batch_id IS NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               AND created_by = ?\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               AND created_at = ?\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               AND task_date = ?\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($totalWaste <= $bands['q1']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['label' => 'Low', 'color' => '#388e3c', 'color_name' => 'Green', 'slug' => 'low'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($totalWaste <= $bands['q2']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['label' => 'Medium-Low', 'color' => '#fbc02d', 'color_name' => 'Yellow', 'slug' => 'medium-low'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($totalWaste <= $bands['q3']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return ['label' => 'Medium-High', 'color' => '#f57c00', 'color_name' => 'Orange', 'slug' => 'medium-high'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['label' => 'High', 'color' => '#d32f2f', 'color_name' => 'Red', 'slug' => 'high'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function formatWasteKgRange($start, $end = null, $exclusiveStart = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($end === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return number_format((float)$start, 2) . ' kg';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ($exclusiveStart ? '>' : '') . number_format((float)$start, 2) . '-' . number_format((float)$end, 2) . ' kg';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteLegend($bands)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $legend = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ['label' => 'High', 'color' => '#d32f2f', 'color_name' => 'Red', 'range' => 'No values'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ['label' => 'Medium-High', 'color' => '#f57c00', 'color_name' => 'Orange', 'range' => 'No values'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ['label' => 'Medium-Low', 'color' => '#fbc02d', 'color_name' => 'Yellow', 'range' => 'No values'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ['label' => 'Low', 'color' => '#388e3c', 'color_name' => 'Green', 'range' => '0.00 kg'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($bands['has_data'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $legend;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (($bands['mode'] ?? '') === 'homogeneous') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $legend[2]['range'] = formatWasteKgRange($bands['min']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $legend;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $legend[3]['range'] = formatWasteKgRange(0, $bands['q1']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $legend[2]['range'] = formatWasteKgRange($bands['q1'], $bands['q2'], true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $legend[1]['range'] = formatWasteKgRange($bands['q2'], $bands['q3'], true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $legend[0]['range'] = formatWasteKgRange($bands['q3'], $bands['max'], true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $legend;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * One heatmap entry per named street/establishment, summed across its saved\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * records. Map-area IDs are only geographic references, never grouping keys.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Rows without a street cannot be attributed to an individual location.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildHeatmapStreetLocations($records)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $mapAreas = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (getEcoTrackHeatmapLocations() as $area) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $mapAreas[$area['id']] = $area;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseKeys = ['Phase 1' => 'phase1a', 'Phase 1A' => 'phase1a', 'Phase 5' => 'phase5', 'Phase 6' => 'phase6'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $locations = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $usedMapAreas = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $street = trim(preg_replace('/\\s+/u', ' ', (string)($record['street'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($street === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = preg_replace('/^Phase (\\d+)-([A-Z])$/', 'Phase $1$2', normalizeWastePhaseLabel($record));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasPhase = preg_match('/^Phase \\d+[A-Z]?$/', $phaseName) === 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseKey = $phaseKeys[$phaseName] ?? null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $groupKey = strtolower(($hasPhase ? $phaseName : '') . "\\x1F" . $street);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($locations[$groupKey])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $mapAreaId = heatmapLocationIdForWasteRecord(['phase_number' => $phaseName, 'street' => $street]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Do not inherit coordinates from a phase with a shared prefix.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($mapAreaId !== null && strpos($mapAreaId, 'phase') === 0 && $phaseKey === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $mapAreaId = null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $area = $mapAreas[$mapAreaId] ?? null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $locations[$groupKey] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'id' => 'street-' . sha1($groupKey),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'name' => $hasPhase ? $phaseName . ' - ' . $street : $street,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'street' => $street,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_name' => $hasPhase ? $phaseName : '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_key' => $phaseKey,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'map_location_id' => $mapAreaId,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'address' => $hasPhase ? $phaseName : 'Barangay San Manuel',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'lat' => $area['lat'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'lng' => $area['lng'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'record_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($mapAreaId !== null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $usedMapAreas[$mapAreaId] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $locations[$groupKey]['total_waste'] += wasteRecordEffectiveKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $locations[$groupKey]['record_count']++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Keep approved establishments available before their first import.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (['toyota-pleasant', 'jollibee-tungko'] as $mapAreaId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (isset($usedMapAreas[$mapAreaId])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $area = $mapAreas[$mapAreaId];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $locations['establishment-' . $mapAreaId] = array_merge($area, [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'id' => 'establishment-' . $mapAreaId,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'street' => $area['name'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'phase_name' => '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'phase_key' => null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'map_location_id' => $mapAreaId,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'record_count' => 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $locations = array_values($locations);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $bands = calculateWasteBands(array_column($locations, 'total_waste'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($locations as &$location) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $location['waste_level'] = classifyWasteTotal($location['total_waste'], $bands);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($location);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     usort($locations, static function ($left, $right) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return strnatcasecmp($left['name'], $right['name']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $locations;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build the source-date collection trend shared by Dashboard and Reports. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildCollectionTrend($records, $limit = 0)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $limit = max(0, (int)$limit);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $periods = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collectionDate = normalizeWasteDateValue($record['collection_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($collectionDate === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Rows without dates remain in totals but cannot appear in date trends.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($periods[$collectionDate])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $date = DateTimeImmutable::createFromFormat('!Y-m-d', $collectionDate);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $periods[$collectionDate] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'collection_date' => $collectionDate,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Retain the date key used by chart templates and explanations.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'date' => $date ? $date->format('M j, Y') : $collectionDate,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'total_waste' => 0.0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phases' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $periods[$collectionDate]['total_waste'] += wasteRecordEffectiveKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = normalizeWastePhaseLabel($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($phaseName !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $periods[$collectionDate]['phases'][$phaseName] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // ISO dates sort naturally; a positive limit selects the latest periods.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($limit > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         krsort($periods, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $periods = array_slice($periods, 0, $limit, true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ksort($periods, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($periods as &$period) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseNames = array_keys($period['phases']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         natcasesort($phaseNames);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $period['phase_label'] = !empty($phaseNames) ? implode(', ', $phaseNames) : 'Unassigned phase';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         unset($period['phases']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($period);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return array_values($periods);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteAnalyticsFromRecords($records)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $heatmapLocations = getEcoTrackHeatmapLocations();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $locationIndex = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($heatmapLocations as $index => $location) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $heatmapLocations[$index]['total_waste'] = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $heatmapLocations[$index]['record_count'] = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $locationIndex[$location['id']] = $index;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summary = ['total_waste' => 0.0, 'total_collected_waste' => 0.0, 'monthly_waste' => 0.0, 'total_records' => count($records)];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseGroups = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentMonth = date('Y-m');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $totalWaste = wasteRecordEffectiveKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $summary['total_waste'] += $totalWaste;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $summary['total_collected_waste'] += $totalWaste;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collectionDate = normalizeWasteDateValue($record['collection_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($collectionDate !== null && substr($collectionDate, 0, 7) === $currentMonth) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $summary['monthly_waste'] += $totalWaste;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = normalizeWastePhaseLabel($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($phaseGroups[$phaseName])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phaseGroups[$phaseName] = ['phase_name' => $phaseName, 'total_waste' => 0.0, 'record_count' => 0, 'average_waste' => 0.0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseGroups[$phaseName]['total_waste'] += $totalWaste;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseGroups[$phaseName]['record_count']++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $locationId = heatmapLocationIdForWasteRecord($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($locationId !== null && isset($locationIndex[$locationId])) \{\par

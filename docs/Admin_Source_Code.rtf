\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     <script>\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function showFileName(input, selectedFileId, fileNameId, submitButtonId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (input.files && input.files[0]) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const fileName = input.files[0].name;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const fileNameElement = document.getElementById(fileNameId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const selectedFileElement = document.getElementById(selectedFileId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const submitButton = submitButtonId ? document.getElementById(submitButtonId) : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fileNameElement.textContent = fileName;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (selectedFileElement.hasAttribute("hidden")) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               selectedFileElement.hidden = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               selectedFileElement.style.display = "block";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (submitButton) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               submitButton.disabled = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function queueAdditionalFiles(input) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (!input.files || !input.files[0]) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const names = Array.from(input.files, (file) => file.name).join(", ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const selectedFiles = document.getElementById("additionalFilesSelected");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           selectedFiles.textContent = "Adding " + input.files.length + " file(s): " + names;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           selectedFiles.hidden = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("addFilesButton").classList.add("is-submitting");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("addFilesButton").textContent = "ADDING FILE(S)...";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           input.form.requestSubmit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     </script>\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 </body>\par

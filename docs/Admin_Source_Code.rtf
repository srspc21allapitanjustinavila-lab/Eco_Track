\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return the single collector row linked to this account, never a posted identity. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ownBioAttendanceQuery(PDO $db, int $userId, string $date): array\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function resolveHeatmapPeriodSelection($dates, $view, $requestedPeriod = '', $allowEmptyRequestedPeriod = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = normalizeHeatmapPeriodView($view);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $options = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($dates as $date) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $date = normalizeWasteDateValue($date);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($date === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $bounds = heatmapPeriodBoundsForDate($view, $date);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $options[$bounds['period']] = $bounds;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     krsort($options, SORT_STRING);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requested = heatmapPeriodBounds($view, $requestedPeriod);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($requested !== null && (isset($options[$requested['period']]) || $allowEmptyRequestedPeriod)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $selection = $options[$requested['period']] ?? $requested;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif (!empty($options)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $selection = reset($options);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $selection = heatmapPeriodBoundsForDate($view, date('Y-m-d'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $selection['day_count'] = (new DateTimeImmutable($selection['start']))->diff(new DateTimeImmutable($selection['end']))->days + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $selection['previous'] = heatmapPreviousPeriodBounds($selection);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $selection['previous']['day_count'] = (new DateTimeImmutable($selection['previous']['start']))->diff(new DateTimeImmutable($selection['previous']['end']))->days + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $selection['options'] = array_values($options);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $selection;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Accept calendar ranges even when no saved rows fall within them. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeHeatmapDateInput($value)\par

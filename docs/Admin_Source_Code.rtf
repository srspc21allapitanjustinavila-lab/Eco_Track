\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $visibleCount = max(1, (int)$visibleCount);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summary = implode(', ', array_slice($labels, 0, $visibleCount));\par

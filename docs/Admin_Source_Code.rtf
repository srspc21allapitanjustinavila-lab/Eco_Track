\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <?php\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Shared weekly trend data and rendering for Dashboard and Reports. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 require_once __DIR__ . '/waste_analytics.php';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWeeklyWasteTrendColumns($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $columns = $conn->query('SHOW COLUMNS FROM waste_records')->fetchAll(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $existingColumns = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($columns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $existingColumns[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($existingColumns['is_active'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             // Existing rows receive the active default after the schema upgrade.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_records ADD COLUMN is_active TINYINT(1) NOT NULL DEFAULT 1 AFTER collection_date');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $indexes = $conn->query('SHOW INDEX FROM waste_records')->fetchAll(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasActiveDateIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($indexes as $index) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (($index['Key_name'] ?? '') === 'idx_waste_records_active_collection_date') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $hasActiveDateIndex = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasActiveDateIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('CREATE INDEX idx_waste_records_active_collection_date ON waste_records (is_active, collection_date)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $checked = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to ensure weekly waste trend columns: ' . $e->getMessage());\par

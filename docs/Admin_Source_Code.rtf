\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $settingsRoute = $user_type === 'staff' ? 'staff_settings.php' : 'admin_system_settings.php';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 if (empty($canonicalRouteEntry) && $_SERVER['REQUEST_METHOD'] === 'GET') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $routeQuery = http_build_query($_GET);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header('Location: ' . $settingsRoute . ($routeQuery === '' ? '' : '?' . $routeQuery));\par

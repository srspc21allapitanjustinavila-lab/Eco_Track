\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $endMonth = normalizeWasteStreetMonthValue($endMonth);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startMonth !== '' && $endMonth === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $endMonth = $startMonth;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif ($endMonth !== '' && $startMonth === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $startMonth = $endMonth;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startMonth !== '' && $endMonth !== '' && $startMonth > $endMonth) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         [$startMonth, $endMonth] = [$endMonth, $startMonth];\par

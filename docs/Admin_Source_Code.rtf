\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $perPage = 25;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $requestedPage = filter_input(INPUT_GET, 'page', FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]) ?: 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $records = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $totalRecordCount = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $totalPages = 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $currentPage = 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 $filteredWasteTotal = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalsStmt = $conn->prepare("SELECT COUNT(*) AS total_records, COALESCE(SUM($recordTotalExpr), 0) AS filtered_total FROM waste_records $where_clause");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalsStmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totals = $totalsStmt->fetch() ?: [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalRecordCount = (int)($totals['total_records'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $filteredWasteTotal = (float)($totals['filtered_total'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $totalPages = max(1, (int)ceil($totalRecordCount / $perPage));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentPage = min($requestedPage, $totalPages);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offset = ($currentPage - 1) * $perPage;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sql = "SELECT *, $recordTotalExpr AS search_waste_total FROM waste_records $where_clause ORDER BY collection_date DESC, id DESC LIMIT $perPage OFFSET $offset";\par

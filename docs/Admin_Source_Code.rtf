\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function deleteStaffAttendance(PDO $db, int $id, int $version, int $actor, string $role): void\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($role !== 'admin') throw new RuntimeException('Administrator access required.', 403);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $db->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find = $db->prepare('SELECT * FROM collector_attendance WHERE id = ? AND collector_user_id IS NOT NULL AND bio_collector_id IS NULL FOR UPDATE');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find->execute([$id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $before = $find->fetch(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$before || $before['deleted_at'] !== null || (int)$before['version'] !== $version) throw new RuntimeException('Attendance changed or was deleted. Reload and try again.', 409);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $update = $db->prepare('UPDATE collector_attendance SET deleted_at = CURRENT_TIMESTAMP, deleted_by = ?, updated_by = ?, version = version + 1 WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $update->execute([$actor, $actor, $id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find->execute([$id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         staffAttendanceAudit($db, $id, 'delete', $actor, $before, $find->fetch(PDO::FETCH_ASSOC));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $db->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($db->inTransaction()) $db->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw $e;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

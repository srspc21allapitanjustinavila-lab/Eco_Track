\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * to reject exact re-uploads independent of filename or row order.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function filterExistingWasteImportPayloadRows($conn, $payloads, $batchId = null)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $known = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($payloads as &$payload) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $fingerprints = array_column($payload['records'], 'record_fingerprint');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (array_chunk(array_values(array_unique($fingerprints)), 500) as $chunk) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (empty($chunk)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $placeholders = implode(',', array_fill(0, count($chunk), '?'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stmt = $conn->prepare("SELECT record_fingerprint FROM waste_record_fingerprints WHERE record_fingerprint IN ($placeholders)");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stmt->execute($chunk);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $fingerprint) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $known[$fingerprint] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($batchId !== null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach (array_chunk(array_values(array_unique($fingerprints)), 500) as $chunk) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 if (empty($chunk)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $placeholders = implode(',', array_fill(0, count($chunk), '?'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $stmt = $conn->prepare("SELECT record_fingerprint FROM waste_import_staging_rows WHERE batch_id = ? AND record_fingerprint IN ($placeholders)");\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'period' => sprintf('%04d-W%02d', $year, $week),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'start' => $start->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'end' => $end->format('Y-m-d'),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'label' => 'Week ' . $week . ' (' . $start->format('M j') . '\u8211?' . $end->format('M j, Y') . ')',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

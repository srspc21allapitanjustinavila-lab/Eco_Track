\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!ensurePersistentLoginTokensTable($conn)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 throw new RuntimeException('Unable to prepare remembered login storage.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $stmt = $conn->prepare("UPDATE users SET password_hash = ? WHERE id = ?");\par

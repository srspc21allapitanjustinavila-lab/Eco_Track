\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isMonthly = mode === 'month';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           var isYearly = mode === 'year';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           dailyPanel.hidden = !isDaily;\par

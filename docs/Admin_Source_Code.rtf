\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             outcome ENUM('imported', 'cancelled', 'duplicate', 'validation_error', 'expired', 'failed') NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             reason_code VARCHAR(60) NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             event_source ENUM('legacy_manifest', 'live') NOT NULL DEFAULT 'live',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             UNIQUE KEY unique_waste_import_event_key (event_key),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INDEX idx_waste_import_events_created_outcome (created_at, outcome),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INDEX idx_waste_import_events_actor_created (actor_user_id, created_at)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         )");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $eventColumns = $conn->query('SHOW COLUMNS FROM waste_import_events')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasSkippedCount = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($eventColumns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (($column['Field'] ?? '') === 'skipped_row_count') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $hasSkippedCount = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasSkippedCount) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('ALTER TABLE waste_import_events ADD COLUMN skipped_row_count INT NOT NULL DEFAULT 0 AFTER valid_row_count');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("CREATE TABLE IF NOT EXISTS waste_import_event_issues (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             event_id BIGINT UNSIGNED NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             worksheet_name VARCHAR(255) NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             source_row_number INT NOT NULL DEFAULT 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             reason_code VARCHAR(60) NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             UNIQUE KEY unique_waste_import_event_issue (event_id, worksheet_name, source_row_number, reason_code),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INDEX idx_waste_import_event_issues_event (event_id)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         )");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

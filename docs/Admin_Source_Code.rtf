\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function heatmapPreviousPeriodBounds($selection)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = $selection['view'];\par

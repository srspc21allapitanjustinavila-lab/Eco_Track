\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function pdfTextValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return str_replace(['\\\\\\\\', '\\\\(', '\\\\)', '\\\\n', '\\\\r'], ['\\\\', '(', ')', ' ', ' '], $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

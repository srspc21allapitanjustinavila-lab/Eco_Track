\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Resolves only the trend query parameters. Other page filters stay intact.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function resolveWeeklyWasteTrendFilters($records, $request)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $datedRecords = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $years = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $latestDate = null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!weeklyWasteTrendIsActiveRecord($record)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $date = weeklyWasteTrendRecordDate($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($date === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $datedRecords[] = $record;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $years[(int)substr($date, 0, 4)] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($latestDate === null || $date > $latestDate) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $latestDate = $date;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Trend selectors may only expose years represented by active saved data.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $yearOptions = array_map('strval', array_keys($years));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     rsort($yearOptions, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $latestYear = $latestDate !== null ? (int)substr($latestDate, 0, 4) : (int)date('Y');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Retain trend_period for bookmarked URLs; the control is year-only.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedPeriod = trim((string)($request['trend_period'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $periodYear = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^((?:19|20)\\d\{2\})-(0[1-9]|1[0-2])$/', $requestedPeriod, $periodMatches)) \{\par

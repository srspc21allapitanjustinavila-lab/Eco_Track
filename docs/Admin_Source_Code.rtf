\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           submitButton.textContent = isMonthly ? 'Apply month' : (isYearly ? 'Apply year' : 'Apply dates');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           submitButton.disabled = isYearly && !hasAvailableYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           modeInputs.forEach(function (input) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedYear = resolveImportedWasteCollectionYear($periodYear !== '' ? $periodYear : ($request['trend_year'] ?? ''), $yearOptions);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $year = $requestedYear !== '' ? (int)$requestedYear : $latestYear;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = ($request['trend_view'] ?? '') === 'week' ? 'week' : 'month';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $locationOptions = buildWeeklyWasteTrendLocationOptions($datedRecords);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $requestedLocation = trim((string)($request['trend_location'] ?? ''));\par

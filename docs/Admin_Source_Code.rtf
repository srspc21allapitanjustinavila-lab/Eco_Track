\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif (empty($new_password) || strlen($new_password) < 8) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "Password must be at least 8 characters.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif (!hash_equals($new_password, $confirm_password)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'Passwords do not match.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         try \{\par

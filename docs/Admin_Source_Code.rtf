\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoBackupList(string $directory): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_dir($directory)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $files = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (glob($directory . DIRECTORY_SEPARATOR . 'ecotrack_*.sql.gz') ?: [] as $path) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $name = basename($path);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!preg_match('/^ecotrack_\\d\{4\}-\\d\{2\}-\\d\{2\}_\\d\{2\}-\\d\{2\}-\\d\{2\}_[a-f0-9]\{8\}\\.sql\\.gz$/', $name)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par

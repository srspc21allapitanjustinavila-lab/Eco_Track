\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif (!in_array($user_type, ['admin', 'staff'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = "Invalid user type selected.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn = getDBConnection();\par

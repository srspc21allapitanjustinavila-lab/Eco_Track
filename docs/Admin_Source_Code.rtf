\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return heatmapPeriodBoundsForDate('week', $start->modify('-1 day'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'month') \{\par

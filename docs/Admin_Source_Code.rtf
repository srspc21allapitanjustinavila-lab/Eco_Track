\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function stageWasteImportPayloads($conn, $batchId, $userId, $payloads, $append = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$append) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $batch = $conn->prepare("INSERT INTO waste_import_batches (id, created_by, expires_at) VALUES (?, ?, DATE_ADD(NOW(), INTERVAL 24 HOUR))");\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Return the valid, deduplicated source rows used by every Street-chart view.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * A missing is_active column denotes legacy active data; an explicit inactive\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * value is never allowed into visualizations or their metadata.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteStreetSourceRows(array $records, array $definitions = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $definitions = $definitions ?: getWasteStreetCategoryDefinitions();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceRows = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $seenFingerprints = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (array_key_exists('is_active', $record) && (int)$record['is_active'] !== 1) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par

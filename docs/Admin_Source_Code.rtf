\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'record_ids' => [],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $recordId = (int)($allocation['waste_record_id'] ?? $allocation['id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phases[$key]['total_waste'] += wasteNumericValue($allocation['kilogram_of_waste'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($recordId > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phases[$key]['record_ids'][$recordId] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $recordIds[$recordId] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseTotals = array_values($phases);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($phaseTotals as &$phase) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phase['total_waste'] = round($phase['total_waste'], 2);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phase['record_count'] = count($phase['record_ids']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phase['average_waste'] = $phase['record_count'] > 0\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? round($phase['total_waste'] / $phase['record_count'], 2)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phase['waste_level'] = classifyDssWasteTotal(\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phase['total_waste'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phase['record_count'] > 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $selection\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         );\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         unset($phase['record_ids']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     unset($phase);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     usort($phaseTotals, static function ($left, $right) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $difference = $right['total_waste'] <=> $left['total_waste'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $difference !== 0 ? $difference : strcasecmp($left['phase_name'], $right['phase_name']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'phase_totals' => $phaseTotals,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'legend' => buildDssWasteLegend($selection),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'selection' => $selection,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'summary' => [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'total_waste' => round(array_sum(array_column($phaseTotals, 'total_waste')), 2),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'record_count' => count($recordIds),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

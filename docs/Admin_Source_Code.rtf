\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildDssPeriodAnalytics($allocations, $selection)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phases = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordIds = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($allocations as $allocation) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $phaseName = normalizeWastePhaseLabel($allocation);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($phaseName === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phaseName = 'Unassigned phase';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $key = strtolower($phaseName);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($phases[$key])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $phases[$key] = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'phase_name' => $phaseName,\par

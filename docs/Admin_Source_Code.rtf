\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? 'Walang active waste records para sa napiling period.'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : 'No active waste records are available for this selected period.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($view === 'week') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $week = $weeks[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((int)$week['event_count'] === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return $isTagalog\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 ? 'Walang naitalang waste collection event sa ' . $week['label'] . '.'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 : $week['label'] . ' has no recorded waste collection events.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $isTagalog\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? 'Ang ' . $week['label'] . ' ay may ' . number_format((float)$week['total_waste'], 2) . ' kg mula sa ' . (int)$week['event_count'] . ' collection event' . ((int)$week['event_count'] === 1 ? '.' : 's.')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : $week['label'] . ' recorded ' . number_format((float)$week['total_waste'], 2) . ' kg across ' . (int)$week['event_count'] . ' collection event' . ((int)$week['event_count'] === 1 ? '.' : 's.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $hasWaste = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($weeks as $week) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)$week['total_waste'] > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasWaste = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$hasWaste) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $isTagalog\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? 'Walang naitalang waste sa limang weekly period ng napiling buwan.'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : 'No waste was recorded across the five weekly periods in this selected month.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $movements = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     for ($index = 1; $index < count($weeks); $index++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $previous = (float)$weeks[$index - 1]['total_waste'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $current = (float)$weeks[$index]['total_waste'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($current > $previous) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $movement = $isTagalog ? 'Tumaas' : 'Waste increased';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} elseif ($current < $previous) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $movement = $isTagalog ? 'Bumaba' : 'Waste decreased';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $movement = $isTagalog ? 'Nanatiling pareho ang waste' : 'Waste remained unchanged';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $movements[] = $isTagalog\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ? $movement . ' mula ' . $weeks[$index - 1]['label'] . ' hanggang ' . $weeks[$index]['label']\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             : $movement . ' from ' . $weeks[$index - 1]['label'] . ' to ' . $weeks[$index]['label'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $highest = $weeks[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lowest = $weeks[0];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($weeks as $week) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)$week['total_waste'] > (float)$highest['total_waste']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $highest = $week;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((float)$week['total_waste'] < (float)$lowest['total_waste']) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $lowest = $week;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($isTagalog) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return implode(', ', $movements) . '. Pinakamataas ang naitalang waste sa ' . $highest['label'] . ' (' . number_format((float)$highest['total_waste'], 2) . ' kg) at pinakamababa sa ' . $lowest['label'] . ' (' . number_format((float)$lowest['total_waste'], 2) . ' kg).';\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Keep a privacy-conscious audit after temporary staging rows are removed. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteImportAuditTable($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("CREATE TABLE IF NOT EXISTS waste_import_events (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,\par

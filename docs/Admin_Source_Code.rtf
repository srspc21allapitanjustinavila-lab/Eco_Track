\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function resolveWasteImportBatchGroups($conn, $batchId, $userId, array $resolutions, $saveRules = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (getWasteImportBatch($conn, $batchId, $userId) === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The pending import is no longer available. Please upload the file again.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $normalized = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($resolutions as $area => $resolution) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $areaKey = normalizeWasteCollectionRuleArea($area);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = trim((string)($resolution['collection_group'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $type = strtolower(trim((string)($resolution['collection_group_type'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($areaKey === '' || $group === '' || !in_array($type, ['phase', 'establishment'], true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $normalized[$areaKey] = ['collection_group' => $group, 'collection_group_type' => $type, 'area' => trim((string)$area)];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($normalized)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('Choose a Collection Group and type for every unresolved area.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $ruleInsert = $conn->prepare("INSERT INTO waste_collection_group_rules (normalized_area, collection_group, collection_group_type, created_by)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             VALUES (?, ?, ?, ?)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ON DUPLICATE KEY UPDATE collection_group = VALUES(collection_group), collection_group_type = VALUES(collection_group_type), is_active = 1");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $rows = $conn->prepare('SELECT * FROM waste_import_staging_rows WHERE batch_id = ? ORDER BY row_number');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $rows->execute([$batchId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $update = $conn->prepare("UPDATE waste_import_staging_rows\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             SET collection_group = ?, collection_group_type = ?, phase_number = ?, phase_date_label = ?, record_fingerprint = ?\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE batch_id = ? AND row_number = ?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($rows->fetchAll() as $row) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $areaKey = normalizeWasteCollectionRuleArea($row['street'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!isset($normalized[$areaKey])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $resolution = $normalized[$areaKey];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!empty($saveRules[$areaKey])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $ruleInsert->execute([$areaKey, $resolution['collection_group'], $resolution['collection_group_type'], $userId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $row['collection_group'] = $resolution['collection_group'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $row['collection_group_type'] = $resolution['collection_group_type'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $row['phase_number'] = substr($resolution['collection_group'], 0, 50);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $row['phase_date_label'] = buildWasteCollectionSourceLabel($resolution['collection_group'], $row['reporting_period'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $row['record_fingerprint'] = buildWasteRecordFingerprint($row);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $update->execute([$row['collection_group'], $row['collection_group_type'], $row['phase_number'], $row['phase_date_label'], $row['record_fingerprint'], $batchId, $row['row_number']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!empty(getWasteImportBatchUnresolvedAreas($conn, $batchId))) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw new RuntimeException('Choose a Collection Group and type for every unresolved area.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         refreshWasteImportBatchDatasetHashes($conn, $batchId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw $e;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

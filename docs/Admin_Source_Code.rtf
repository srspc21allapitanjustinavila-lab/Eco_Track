\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoBackupPrepareDirectory(string $directory): string\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_dir($directory) && !@mkdir($directory, 0700, true) && !is_dir($directory)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The backup folder could not be created.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $resolved = realpath($directory);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $project = realpath(dirname(__DIR__));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $documentRoot = !empty($_SERVER['DOCUMENT_ROOT']) ? realpath($_SERVER['DOCUMENT_ROOT']) : false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($resolved === false || $project === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The backup folder could not be resolved.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $folder = strtolower(rtrim(str_replace('\\\\', '/', $resolved), '/')) . '/';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ([$project, $documentRoot] as $root) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($root === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $root = strtolower(rtrim(str_replace('\\\\', '/', $root), '/')) . '/';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (strpos($folder, $root) === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw new RuntimeException('The backup folder must be outside the website directory.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $resolved;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteRecordCategoryKg($record, $category)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     switch ($category) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         case 'returnable': return wasteRecordReturnableKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         case 'biowaste': return wasteRecordBiowasteKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         case 'residual': return wasteRecordResidualKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         case 'hazardous': return wasteRecordHazardousKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         case 'unclassified': return wasteRecordUnclassifiedKg($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         default: return 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Resolve a chartable category breakdown for one record.  Older rows can have\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * only a legacy total, so preserve that amount as unclassified rather than\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * showing a total bar with no visible stacked segment.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteRecordStreetCategoryBreakdown($record, array $definitions)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $categories = array_fill_keys(array_keys($definitions), 0.0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $knownTotal = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($categories as $category => $unused) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $amount = max(0.0, wasteRecordCategoryKg($record, $category));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categories[$category] = $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $knownTotal += $amount;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $effectiveTotal = max(0.0, wasteRecordEffectiveKg($record));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (array_key_exists('unclassified', $categories) && $effectiveTotal > $knownTotal) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $categories['unclassified'] += $effectiveTotal - $knownTotal;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $knownTotal = $effectiveTotal;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'categories' => $categories,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Detailed category fields are more specific than an incomplete\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // legacy total, while still retaining a larger legacy total above.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'total_waste' => max($effectiveTotal, $knownTotal),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteStreetComparisonKey($phaseName, $street)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return hash('sha256', strtolower(trim((string)$phaseName)) . "\\x1F" . strtolower(trim((string)$street)));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Normalize the Street chart's Phase, category, and inclusive exact-date bounds. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteStreetFilters(array $filters, array $definitions = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $definitions = $definitions ?: getWasteStreetCategoryDefinitions();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $category = strtolower(trim((string)($filters['category'] ?? 'all')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($category !== 'all' && !isset($definitions[$category])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $category = 'all';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $startDate = normalizeWasteDateValue($filters['start_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $endDate = normalizeWasteDateValue($filters['end_date'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startDate !== null && $endDate === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $endDate = $startDate;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} elseif ($endDate !== null && $startDate === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $startDate = $endDate;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($startDate !== null && $endDate !== null && $startDate > $endDate) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         [$startDate, $endDate] = [$endDate, $startDate];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'phase' => trim((string)($filters['phase'] ?? '')),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'category' => $category,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'start_date' => $startDate ?: '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'end_date' => $endDate ?: '',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return a safe YYYY-MM month value used by the Street month controls. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteStreetMonthValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = is_string($value) ? trim($value) : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return preg_match('/^(19|20)\\\\d\{2\}-(0[1-9]|1[0-2])$/', $value) ? $value : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Convert one or two selected Street months into inclusive database dates.\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $issueInsert = $conn->prepare('INSERT IGNORE INTO waste_import_batch_issues (batch_id, source_file_sha256, worksheet_name, source_row_number, reason_code) VALUES (?, ?, ?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stageColumns = wasteImportStageColumns();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $allColumns = array_merge(['batch_id', 'row_number', 'source_file_sha256', 'record_fingerprint'], $stageColumns);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $rowPlaceholder = '(' . implode(', ', array_fill(0, count($allColumns), '?')) . ')';\par

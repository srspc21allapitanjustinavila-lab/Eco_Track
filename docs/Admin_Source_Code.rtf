\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Validate and consume a purpose-scoped code in the same request. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function verifyAndConsumeActionOtp($conn, array $user, $purpose, $code)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function backfillWasteDailyAllocations($conn, $batchSize = 500)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteDailyAllocationTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $batchSize = max(1, (int)$batchSize);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $conn->prepare('SELECT wr.* FROM waste_records wr LEFT JOIN waste_daily_allocations da ON da.waste_record_id = wr.id WHERE da.waste_record_id IS NULL AND wr.is_active = 1 ORDER BY wr.id ASC LIMIT ' . $batchSize);\par

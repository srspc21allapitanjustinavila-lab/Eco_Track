\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function splitWasteAmountAcrossDays($amount, $days)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $days = max(1, (int)$days);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $cents = (int)round(max(0, wasteNumericValue($amount)) * 100);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $base = intdiv($cents, $days);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $remainder = $cents - ($base * $days);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $parts = array_fill(0, $days, $base / 100);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $parts[$days - 1] = ($base + $remainder) / 100;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $parts;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Build equal, inclusive daily rows without mutating the source record. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteDailyAllocations($record)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $range = wasteReportingRangeForRecord($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($range === null) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $start = new DateTimeImmutable($range['start']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $end = new DateTimeImmutable($range['end']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $days = $start->diff($end)->days + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $components = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $componentTotal = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (wasteDailyAllocationComponentColumns() as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $components[$column] = wasteNumericValue($record[$column] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $componentTotal += $components[$column];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Preserve recorded totals from older imports in period analytics.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($componentTotal <= 0 && wasteNumericValue($record['kilogram_of_waste'] ?? 0) > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $components['residual_waste_kg'] = wasteNumericValue($record['kilogram_of_waste']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $splitComponents = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($components as $column => $amount) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $splitComponents[$column] = splitWasteAmountAcrossDays($amount, $days);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $allocations = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     for ($index = 0; $index < $days; $index++) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $date = $start->modify('+' . $index . ' days')->format('Y-m-d');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $allocation = ['allocation_date' => $date];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $total = 0.0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (wasteDailyAllocationComponentColumns() as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $allocation[$column] = $splitComponents[$column][$index];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $total += $allocation[$column];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $allocation['kilogram_of_waste'] = round($total, 2);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $allocations[] = $allocation;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $allocations;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function storeWasteDailyAllocations($conn, $record)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteDailyAllocationTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordId = (int)($record['id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($recordId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('A saved waste record is required before daily allocations can be created.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $allocations = buildWasteDailyAllocations($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (empty($allocations)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $columns = array_merge(['waste_record_id'], array_keys($allocations[0]));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updates = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (array_slice($columns, 2) as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $updates[] = $column . ' = VALUES(' . $column . ')';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $conn->prepare('INSERT INTO waste_daily_allocations (' . implode(', ', $columns) . ') VALUES (' . implode(', ', array_fill(0, count($columns), '?')) . ') ON DUPLICATE KEY UPDATE ' . implode(', ', $updates));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($allocations as $allocation) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute(array_merge([$recordId], array_values($allocation)));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return count($allocations);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Rebuild derived calendar rows after a source record changes. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function rebuildWasteDailyAllocationsForRecord($conn, $recordId)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

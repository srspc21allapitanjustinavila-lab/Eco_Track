\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Check for saved theme preference on page load\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         document.addEventListener("DOMContentLoaded", function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const savedTheme = localStorage.getItem("theme") || "light";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const themeToggle = document.getElementById("themeToggle");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const themeLabel = document.getElementById("themeLabel");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (savedTheme === "dark") \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             document.documentElement.setAttribute("data-theme", "dark");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             themeToggle.classList.add("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             themeLabel.textContent = "DARK";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             document.documentElement.setAttribute("data-theme", "light");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             themeToggle.classList.remove("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             themeLabel.textContent = "LIGHT";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function toggleTheme(toggle) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           toggle.classList.toggle("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const isDark = toggle.classList.contains("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const theme = isDark ? "dark" : "light";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           // Apply theme to document\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.documentElement.setAttribute("data-theme", theme);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("theme").value = theme;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           // Update label\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           toggle.nextElementSibling.textContent = isDark ? "DARK" : "LIGHT";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           // Save to localStorage\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           localStorage.setItem("theme", theme);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function toggleStoredToggle(toggle, inputId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const hiddenInput = document.getElementById(inputId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (!hiddenInput) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const isActive = toggle.classList.toggle("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           toggle.setAttribute("aria-checked", isActive ? "true" : "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           hiddenInput.value = isActive ? "1" : "0";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function toggleStoredToggleOnKey(event, toggle, inputId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (event.key !== "Enter" && event.key !== " ") return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           event.preventDefault();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           toggleStoredToggle(toggle, inputId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function checkStrength(password) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const fill = document.getElementById("strengthFill");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const text = document.getElementById("strengthText");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           let strength = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (password.length >= 6) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (password.length >= 10) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[A-Z]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[0-9]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (/[^A-Za-z0-9]/.test(password)) strength++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           fill.className = "strength-fill";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (strength <= 2) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.width = "30%";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#f44336";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: WEAK";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \} else if (strength <= 4) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.width = "60%";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#ff9800";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: MEDIUM";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.width = "100%";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             fill.style.background = "#4caf50";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             text.textContent = "PASSWORD STRENGTH: STRONG";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function weeklyWasteTrendWeekBuckets($year, $month)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $periodStart = new DateTimeImmutable(sprintf('%04d-%02d-01', (int)$year, (int)$month));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lastDay = (int)$periodStart->format('t');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $buckets = [];\par

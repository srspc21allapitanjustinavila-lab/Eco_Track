\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function detectUploadFormat($file)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sample = file_get_contents($file['tmp_name'], false, null, 0, 16);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($sample === false || $sample === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The selected file could not be read. Please wait for the download to finish, then try again.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Do not rely on the browser MIME type: newly downloaded files are often\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // reported as application/octet-stream until the browser finishes indexing them.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $extension = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (strncmp($sample, '%PDF-', 5) === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'pdf';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (strncmp($sample, "PK\\x03\\x04", 4) === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $extension === 'docx' ? 'docx' : 'xlsx';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (strncmp($sample, "\\xD0\\xCF\\x11\\xE0", 4) === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'xls';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($extension === 'json') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'json';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (in_array($extension, ['docx', 'xls'], true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The selected .' . $extension . ' file is not a readable ' . strtoupper($extension) . ' document. It may be encrypted, corrupted, or mislabeled.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (in_array($extension, ['csv', 'txt'], true) || preg_match('//u', $sample)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'csv';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     throw new RuntimeException('Unsupported file. Choose CSV/TXT, Excel (.xlsx, .xlsm, or .xls), JSON, DOCX table, or a text-based PDF.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

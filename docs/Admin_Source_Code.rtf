\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               AND description = ?\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               AND priority = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($legacyBatches->fetchAll() as $legacyBatch) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $assignBatch->execute([\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 bin2hex(random_bytes(16)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 (int)$legacyBatch['created_by'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $legacyBatch['created_at'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $legacyBatch['task_date'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $legacyBatch['title'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $legacyBatch['description'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $legacyBatch['priority'],\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $checked = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to prepare daily task batches: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

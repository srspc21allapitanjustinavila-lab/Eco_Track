\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function fetchHeatmapPeriodAnalytics($conn, $view, $period = '', $startDate = '', $endDate = '', $allowEmptyRequestedPeriod = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $view = normalizeHeatmapPeriodView($view);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteAnalyticsColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteDailyAllocationTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $dates = $conn->query('SELECT DISTINCT da.allocation_date FROM waste_daily_allocations da INNER JOIN waste_records wr ON wr.id = da.waste_record_id WHERE wr.is_active = 1 ORDER BY da.allocation_date')->fetchAll(PDO::FETCH_COLUMN);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $dateRange = $view === 'week' ? resolveHeatmapDateRangeSelection($startDate, $endDate) : null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $selection = $dateRange ?: resolveHeatmapPeriodSelection($dates, $view, $period, $allowEmptyRequestedPeriod || $view === 'year');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceRecords = $conn->query("SELECT * FROM waste_records WHERE is_active = 1 AND street IS NOT NULL AND TRIM(street) <> ''")->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentStmt = $conn->prepare('SELECT wr.*, da.waste_record_id, da.allocation_date, da.kilogram_of_waste FROM waste_daily_allocations da INNER JOIN waste_records wr ON wr.id = da.waste_record_id WHERE wr.is_active = 1 AND da.allocation_date BETWEEN ? AND ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $currentStmt->execute([$selection['start'], $selection['end']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $previousStmt = $conn->prepare('SELECT wr.*, da.waste_record_id, da.allocation_date, da.kilogram_of_waste FROM waste_daily_allocations da INNER JOIN waste_records wr ON wr.id = da.waste_record_id WHERE wr.is_active = 1 AND da.allocation_date BETWEEN ? AND ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $previousStmt->execute([$selection['previous']['start'], $selection['previous']['end']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return buildHeatmapPeriodAnalytics($sourceRecords, $currentStmt->fetchAll(), $previousStmt->fetchAll(), $selection);\par

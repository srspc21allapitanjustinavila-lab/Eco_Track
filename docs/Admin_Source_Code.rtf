\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'location' => $location,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'location_label' => $location !== '' ? $locationOptions[$location]['label'] : 'All streets / locations',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'year_options' => $yearOptions,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'location_options' => $locationOptions,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWeeklyWasteTrendLocationOptions($records)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $options = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!weeklyWasteTrendIsActiveRecord($record) || weeklyWasteTrendRecordDate($record) === null) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function createUserNotification($conn, $recipientUserId, $title, $message, $destinationUrl = '', $notificationType = 'general', $actorUserId = null)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recipientUserId = (int)$recipientUserId;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $recipientUserId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // MySQL DDL commits implicitly; initialize this table before a transaction.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ensureNotificationsTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('INSERT INTO notifications (recipient_user_id, actor_user_id, notification_type, title, message, destination_url) VALUES (?, ?, ?, ?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $recipientUserId,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $actorUserId ? (int)$actorUserId : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             trim((string)$notificationType) ?: 'general',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             trim((string)$title),\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteCollectionSourceLabel($collectionGroup, $reportingPeriod)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $collectionGroup = trim((string)$collectionGroup);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reportingPeriod = trim((string)$reportingPeriod);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($collectionGroup !== '' && $reportingPeriod !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $collectionGroup . ' (' . $reportingPeriod . ')';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $collectionGroup !== '' ? $collectionGroup : $reportingPeriod;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isWastePhaseDateValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($value === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return stripos($value, 'Phase') !== false && (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         preg_match('/\\b(19|20)\\d\{2\}\\b/', $value) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         preg_match('/\\b(January|February|March|April|May|June|July|August|September|October|November|December)\\b/i', $value) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         strpos($value, '(') !== false\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     );\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function cleanWasteHouseholdsValue($households, $phaseDateLabel = '', $phaseNumber = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $households = trim((string)$households);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseDateLabel = trim((string)$phaseDateLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseNumber = trim((string)$phaseNumber);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($households === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ($phaseDateLabel !== '' && strcasecmp($households, $phaseDateLabel) === 0) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ($phaseNumber !== '' && isWastePhaseDateValue($phaseNumber) && strcasecmp($households, $phaseNumber) === 0) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         isWastePhaseDateValue($households)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $households;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteFormatColumns($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $existing = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $columns = $conn->query("SHOW COLUMNS FROM waste_records")->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($columns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $existing[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (getWasteFormatColumns() as $columnName => $definition) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!isset($existing[$columnName])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->exec("ALTER TABLE waste_records ADD COLUMN `$columnName` $definition");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Older installations may contain duplicate historical rows.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $indexes = $conn->query('SHOW INDEX FROM waste_records')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasFingerprintIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasDateGroupIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasUniqueFingerprint = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasActiveDateIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($indexes as $index) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasFingerprintIndex = $hasFingerprintIndex || (($index['Key_name'] ?? '') === 'idx_waste_records_fingerprint');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasDateGroupIndex = $hasDateGroupIndex || (($index['Key_name'] ?? '') === 'idx_waste_records_date_group');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasUniqueFingerprint = $hasUniqueFingerprint || (($index['Key_name'] ?? '') === 'unique_waste_records_fingerprint');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $hasActiveDateIndex = $hasActiveDateIndex || (($index['Key_name'] ?? '') === 'idx_waste_records_active_collection_date');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasFingerprintIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('CREATE INDEX idx_waste_records_fingerprint ON waste_records (record_fingerprint)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasDateGroupIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('CREATE INDEX idx_waste_records_date_group ON waste_records (collection_date, collection_group, id)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasActiveDateIndex) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec('CREATE INDEX idx_waste_records_active_collection_date ON waste_records (is_active, collection_date)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$hasUniqueFingerprint) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $duplicateFingerprint = $conn->query("SELECT record_fingerprint FROM waste_records WHERE record_fingerprint IS NOT NULL AND record_fingerprint <> '' GROUP BY record_fingerprint HAVING COUNT(*) > 1 LIMIT 1")->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($duplicateFingerprint === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->exec('CREATE UNIQUE INDEX unique_waste_records_fingerprint ON waste_records (record_fingerprint)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 error_log('Waste record fingerprint uniqueness deferred because historical duplicate rows exist.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (isset($existing['households']) || array_key_exists('households', getWasteFormatColumns())) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec("\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 UPDATE waste_records\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 SET households = ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 WHERE households IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   AND households <> ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   AND (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     households = phase_date_label\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     OR households = phase_number\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     OR (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                         households LIKE '%Phase%'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                         AND (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                             households REGEXP '(19|20)[0-9]\{2\}'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                             OR households REGEXP 'January|February|March|April|May|June|July|August|September|October|November|December'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                             OR households LIKE '%(%'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                         )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec("\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 UPDATE waste_records wr\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 JOIN (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     SELECT street, MAX(CAST(households AS UNSIGNED)) AS recovered_households\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     FROM waste_records\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     WHERE households IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                       AND households <> ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                       AND households REGEXP '^[0-9]+$'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     GROUP BY street\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 ) source_rows ON source_rows.street = wr.street\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 SET wr.households = source_rows.recovered_households\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 WHERE (wr.households IS NULL OR wr.households = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   AND source_rows.recovered_households IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log("Failed to ensure waste format columns: " . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Deleted Waste Data is kept in a permanent, recoverable archive. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteRecordsArchiveTable($conn)\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Atomically link a collector account to one registry identity, never a posted name alone. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function linkWasteCollectorAccount(PDO $conn, int $userId, int $collectorId, string $newCollectorName = ''): void\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($collectorId > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup = $conn->prepare('SELECT id, user_id FROM bio_collectors WHERE id = ? AND (is_active = 1 OR user_id = ?) FOR UPDATE');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup->execute([$collectorId, $userId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collector = $lookup->fetch(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$collector) throw new InvalidArgumentException('Choose an active Waste Collector record.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($collector['user_id'] !== null && (int)$collector['user_id'] !== $userId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw new InvalidArgumentException('That Waste Collector is already linked to another account.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($collector['user_id'] !== null && (int)$collector['user_id'] === $userId) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $newCollectorName = attendanceName($newCollectorName);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($newCollectorName === '') throw new InvalidArgumentException('Select an existing Waste Collector or enter a new collector name.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (strlen($newCollectorName) > 255) throw new InvalidArgumentException('Collector name must be 255 characters or fewer.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $key = attendanceNameKey($newCollectorName);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup = $conn->prepare('SELECT id, user_id FROM bio_collectors WHERE name_key = ? FOR UPDATE');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lookup->execute([$key]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $collector = $lookup->fetch(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($collector) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($collector['user_id'] !== null && (int)$collector['user_id'] !== $userId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 throw new InvalidArgumentException('A collector with that name is already linked to another account.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $collectorId = (int)$collector['id'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $insert = $conn->prepare('INSERT INTO bio_collectors (name, name_key, user_id) VALUES (?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $insert->execute([$newCollectorName, $key, $userId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $unlink = $conn->prepare('UPDATE bio_collectors SET user_id = NULL WHERE user_id = ? AND id <> ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $unlink->execute([$userId, $collectorId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $link = $conn->prepare('UPDATE bio_collectors SET user_id = ? WHERE id = ? AND (user_id IS NULL OR user_id = ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $link->execute([$userId, $collectorId, $userId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($link->rowCount() !== 1) throw new RuntimeException('Unable to link the Waste Collector account.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

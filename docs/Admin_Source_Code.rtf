\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function inferWasteImportPeriod($sourceLabel)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceLabel = trim((string)$sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($sourceLabel === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Use filename dates for three-day workbooks when no dated row is available.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceLabel = preg_replace('/\\.(?:csv|xlsx|xlsm|pdf)$/i', '', $sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/\\b(?:19|20)\\d\{2\}\\b/', $sourceLabel)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $sourceLabel;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $monthNames = 'january|jan|february|feb|march|mar|april|apr|may|june|jun|july|jul|august|aug|september|sept|sep|october|oct|november|nov|december|dec';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $datePattern = '/\\b(?:' . $monthNames . ')\\.?\\s*\\d\{1,2\}(?:\\s*[-\u226?\u8364?\u8220?\u226?\u8364?\u8221?]\\s*(?:(?:' . $monthNames . ')\\.?\\s*)?\\d\{1,2\})?\\b/i';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match($datePattern, $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return trim($matches[0]) . ' ' . date('Y');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteWorksheetSourceLabel($sheetName, $blockLabel, $fileLabel = '')\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordId = (int)$recordId;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($recordId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $delete = $conn->prepare('DELETE FROM waste_daily_allocations WHERE waste_record_id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $delete->execute([$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordQuery = $conn->prepare('SELECT * FROM waste_records WHERE id = ? AND is_active = 1 LIMIT 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordQuery->execute([$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $record = $recordQuery->fetch();\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function wasteImportFindExistingValue($conn, $column, $values, $table)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (array_chunk(array_values(array_unique($values)), 500) as $chunk) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($chunk)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $placeholders = implode(',', array_fill(0, count($chunk), '?'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare("SELECT `$column` FROM `$table` WHERE `$column` IN ($placeholders) LIMIT 1");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute($chunk);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($stmt->fetchColumn() !== false) \{\par

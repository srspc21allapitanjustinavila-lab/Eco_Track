\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     <script>\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function updateAddAccountLabels() \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const role = document.getElementById("add_user_type").value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const roleName = role === "admin" ? "ADMIN" : (role === "waste_collector" ? "WASTE COLLECTOR" : "STAFF");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("addAccountTitle").textContent = "ADD " + roleName + " ACCOUNT";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("addAccountNotice").textContent = "Create a new " + roleName.toLowerCase() + " account.";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("addAccountSubmit").textContent = "ADD " + roleName + " ACCOUNT";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function openAddModal(role) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.getElementById("add_user_type").value = ["admin", "staff", "waste_collector"].includes(role) ? role : "staff";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           updateAddAccountLabels();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           openModal("addModal");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function openModal(modalId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const overlay = document.getElementById(modalId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (!overlay) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           overlay.classList.add("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const firstField = overlay.querySelector('input:not([type="hidden"]), select, textarea, button');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (firstField) window.setTimeout(() => firstField.focus(), 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function closeModal(modalId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           const overlay = document.getElementById(modalId);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (overlay) overlay.classList.remove("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         function previewPhoto(input, previewId) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (input.files && input.files[0]) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const reader = new FileReader();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             reader.onload = function (e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               document.getElementById(previewId).innerHTML = '<img src="' + e.target.result + '">';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \};\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             reader.readAsDataURL(input.files[0]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         document.querySelectorAll(".modal-overlay").forEach((overlay) => \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           overlay.addEventListener("click", function (e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (e.target === this) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0               this.classList.remove("active");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         document.addEventListener("keydown", function (event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           if (event.key !== "Escape") return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           document.querySelectorAll(".modal-overlay.active").forEach((overlay) => overlay.classList.remove("active"));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         document.querySelectorAll("[data-password-toggle]").forEach((button) => \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           button.addEventListener("click", function () \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             const input = document.getElementById(button.dataset.passwordToggle);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!input) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             input.type = input.type === "password" ? "text" : "password";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             button.textContent = input.type === "password" ? "Show" : "Hide";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             button.setAttribute("aria-pressed", input.type === "text" ? "true" : "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         updateAddAccountLabels();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     </script>\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function syncBioCollectors(PDO $db): void\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Keep linked records, but exclude this exact name even if imported again.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $excludedKey = attendanceNameKey('sada');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $deactivate = $db->prepare('UPDATE bio_collectors SET is_active = 0 WHERE name_key = ? AND is_active = 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $deactivate->execute([$excludedKey]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $columns = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($db->query('SHOW COLUMNS FROM waste_records') as $column) $columns[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $names = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach (['name_of_bioman', 'garbage_collector'] as $column) if (isset($columns[$column])) $names[] = "NULLIF(TRIM(`$column`), '')";\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$names) return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $expression = count($names) === 1 ? $names[0] : 'COALESCE(' . implode(', ', $names) . ')';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // An older waste row may already have been archived before the registry\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // existed. Its named collector is still an existing collector identity.\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Check if account is locked due to too many attempts\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isAccountLocked($username)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $username = trim((string)$username);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($username === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $conn = getDBConnection();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Do not grant a login attempt when the lockout state cannot be read.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('SELECT COUNT(*) FROM login_attempts WHERE username = ? AND success = 0 AND attempt_time >= DATE_SUB(NOW(), INTERVAL ' . (int)LOGIN_ATTEMPT_WINDOW . ' MINUTE)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$username]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return (int)$stmt->fetchColumn() >= MAX_LOGIN_ATTEMPTS;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Could not check account lock status: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Check if session has timed out\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isSessionTimeout()\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     initSession();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (isset($_SESSION['last_activity'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $inactive = time() - $_SESSION['last_activity'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $timeoutSeconds = (int)($_SESSION['session_timeout_seconds'] ?? SESSION_TIMEOUT);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($timeoutSeconds <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $timeoutSeconds = SESSION_TIMEOUT;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($inactive >= $timeoutSeconds) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Update last activity timestamp\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function updateLastActivity()\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     initSession();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $_SESSION['last_activity'] = time();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Logout user and clear session\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function logoutUser($revokePersistentLogin = true)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     initSession();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($revokePersistentLogin) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn = getDBConnection();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         revokeCurrentPersistentLogin($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     session_unset();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     session_destroy();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sessionCookie = session_get_cookie_params();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     setcookie(session_name(), '', time() - 42000, $sessionCookie['path'] ?? '/', $sessionCookie['domain'] ?? '', (bool)($sessionCookie['secure'] ?? false), (bool)($sessionCookie['httponly'] ?? true));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     sendNoCacheHeaders();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

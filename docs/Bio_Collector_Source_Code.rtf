\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (isset($existing['households']) || array_key_exists('households', getWasteFormatColumns())) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec("\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 UPDATE waste_records\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 SET households = ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 WHERE households IS NOT NULL\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   AND households <> ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   AND (\par

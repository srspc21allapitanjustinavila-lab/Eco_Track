\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Skip spreadsheet summary rows, where TOTAL commonly appears in Area. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isWasteTotalLabel($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function saveStaffAttendance(PDO $db, string $date, array $entries, int $actor): int\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!attendanceValidDate($date)) throw new InvalidArgumentException('Invalid attendance date.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (count($entries) > 200) throw new InvalidArgumentException('Too many attendance entries.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ksort($entries, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $db->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $changed = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $lock = $db->prepare("SELECT id FROM users WHERE id = ? AND user_type = 'staff' AND is_active = 1 FOR UPDATE");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find = $db->prepare('SELECT * FROM collector_attendance WHERE collector_user_id = ? AND bio_collector_id IS NULL AND attendance_date = ? FOR UPDATE');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $create = $db->prepare('INSERT INTO collector_attendance (collector_user_id, attendance_date, status, remarks, recorded_by, updated_by) VALUES (?, ?, ?, ?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $update = $db->prepare('UPDATE collector_attendance SET status = ?, remarks = ?, updated_by = ?, deleted_at = NULL, deleted_by = NULL, version = version + 1 WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($entries as $rawId => $entry) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $id = filter_var($rawId, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!$id || !is_array($entry)) throw new InvalidArgumentException('Invalid staff selection.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $status = is_string($entry['status'] ?? null) ? trim($entry['status']) : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $remarks = is_string($entry['remarks'] ?? null) ? trim($entry['remarks']) : '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $version = filter_var($entry['version'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 0]]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($version === false || ($status !== '' && normalizeAttendanceStatus($status) !== $status) || strlen($remarks) > 500) throw new InvalidArgumentException('Invalid status, remarks, or record version.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($status === '' && $remarks !== '') throw new InvalidArgumentException('Select a status before adding remarks.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $lock->execute([$id]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!$lock->fetchColumn()) throw new InvalidArgumentException('A staff account is no longer active.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $find->execute([$id, $date]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $before = $find->fetch(PDO::FETCH_ASSOC) ?: null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ((int)($before['version'] ?? 0) !== $version) throw new RuntimeException('Attendance changed in another session. Reload and try again.', 409);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($status === '') continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($before && $before['deleted_at'] === null && $before['status'] === $status && $before['remarks'] === $remarks) continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($before) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $update->execute([$status, $remarks, $actor, $before['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $recordId = (int)$before['id'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $action = $before['deleted_at'] !== null ? 'restore' : 'update';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $create->execute([$id, $date, $status, $remarks, $actor, $actor]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $recordId = (int)$db->lastInsertId();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $action = 'create';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $find->execute([$id, $date]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             staffAttendanceAudit($db, $recordId, $action, $actor, $before, $find->fetch(PDO::FETCH_ASSOC));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $changed++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $db->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $changed;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                             OR households REGEXP 'January|February|March|April|May|June|July|August|September|October|November|December'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                             OR households LIKE '%(%'\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                         )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                   )\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->exec("\par

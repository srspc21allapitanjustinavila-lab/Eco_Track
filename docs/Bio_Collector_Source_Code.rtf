\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function bioAttendanceQuery(PDO $db, string $date, string $search, string $status, int $page, int $pageSize = 30): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     [$where, $params] = bioAttendanceWhere($date, $search, $status);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $from = ' FROM bio_collectors c LEFT JOIN collector_attendance a ON a.bio_collector_id = c.id AND a.attendance_date = ?';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summaryStmt = $db->prepare("SELECT CASE WHEN a.id IS NULL OR a.deleted_at IS NOT NULL THEN 'not_recorded' ELSE a.status END AS state, COUNT(*) AS total $from WHERE $where GROUP BY state");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summaryStmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summary = array_fill_keys(array_merge(array_keys(attendanceStatusOptions()), ['not_recorded']), 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($summaryStmt as $row) if (isset($summary[$row['state']])) $summary[$row['state']] = (int)$row['total'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $total = array_sum($summary);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $pages = max(1, (int)ceil($total / $pageSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $page = max(1, min($page, $pages));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offset = ($page - 1) * $pageSize;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $db->prepare("SELECT c.id, c.name, a.id AS attendance_id, a.status, a.remarks, a.deleted_at, a.version, recorder.username AS recorder, editor.username AS editor $from LEFT JOIN users recorder ON recorder.id = a.recorded_by LEFT JOIN users editor ON editor.id = a.updated_by WHERE $where ORDER BY c.name, c.id LIMIT $pageSize OFFSET $offset");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['rows' => $stmt->fetchAll(PDO::FETCH_ASSOC), 'summary' => $summary, 'total' => $total, 'page' => $page, 'pages' => $pages];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

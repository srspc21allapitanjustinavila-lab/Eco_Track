\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $consume = $conn->prepare('UPDATE data_export_otps SET used = 1, used_at = NOW() WHERE id = ? AND user_id = ? AND purpose = ? AND used = 0 AND expires_at > NOW()');\par

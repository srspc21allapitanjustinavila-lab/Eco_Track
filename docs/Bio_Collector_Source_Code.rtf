\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 // Create database connection\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getDBConnection()\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn = new PDO(\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'mysql:host=' . DB_HOST . ';dbname=' . DB_NAME . ';charset=utf8mb4',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             DB_USER,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             DB_PASS,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             [PDO::ATTR_EMULATE_PREPARES => false]\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         );\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $conn;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log("Database connection failed: " . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /**\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Store a profile image without trusting the original filename or browser MIME hint.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Returns null when no image was selected, false on validation failure, or a web path.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function storeUserPhotoUpload($upload, &$error)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $error = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_array($upload) || ($upload['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_NO_FILE) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (($upload['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK || empty($upload['tmp_name']) || !is_uploaded_file($upload['tmp_name'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'The profile image could not be uploaded. Please try again.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $size = (int)($upload['size'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($size <= 0 || $size > MAX_PROFILE_PHOTO_BYTES) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'Profile images must be 5 MB or smaller.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $mimeType = (new finfo(FILEINFO_MIME_TYPE))->file($upload['tmp_name']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $extensions = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'image/jpeg' => 'jpg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'image/png' => 'png',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'image/webp' => 'webp',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!isset($extensions[$mimeType])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'Profile images must be JPEG, PNG, or WebP files.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $uploadDirectory = __DIR__ . '/uploads/users';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_dir($uploadDirectory) && !mkdir($uploadDirectory, 0750, true) && !is_dir($uploadDirectory)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'The profile image storage is unavailable.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $filename = bin2hex(random_bytes(16)) . '.' . $extensions[$mimeType];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Could not generate a profile image filename: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'The profile image could not be stored. Please try again.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $destination = $uploadDirectory . '/' . $filename;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!move_uploaded_file($upload['tmp_name'], $destination)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $error = 'The profile image could not be stored. Please try again.';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     @chmod($destination, 0640);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return 'uploads/users/' . $filename;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function getWasteFormatColumns()\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par

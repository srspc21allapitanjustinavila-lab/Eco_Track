\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function syncWasteRecordFingerprint($conn, $recordId, $previousFingerprint = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || (int)$recordId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $select = $conn->prepare('SELECT * FROM waste_records WHERE id = ? AND is_active = 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $select->execute([(int)$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $record = $select->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fingerprint = buildWasteRecordFingerprint($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $update = $conn->prepare('UPDATE waste_records SET record_fingerprint = ? WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $update->execute([$fingerprint, (int)$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $insert = $conn->prepare('INSERT IGNORE INTO waste_record_fingerprints (record_fingerprint) VALUES (?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $insert->execute([$fingerprint]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $previousFingerprint = trim((string)$previousFingerprint);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($previousFingerprint !== '' && $previousFingerprint !== $fingerprint) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stillUsed = $conn->prepare('SELECT COUNT(*) FROM waste_records WHERE record_fingerprint = ? AND is_active = 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stillUsed->execute([$previousFingerprint]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ((int)$stillUsed->fetchColumn() === 0) \{\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <script>\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     let sharedLogoutTrigger = null;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     function showLogoutModal(event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         event.preventDefault();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         sharedLogoutTrigger = event.currentTarget;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const modal = document.getElementById("logoutModal");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (modal) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         modal.classList.add("show");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         modal.setAttribute("aria-hidden", "false");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const cancelButton = modal.querySelector("[data-logout-cancel]");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (cancelButton) window.setTimeout(() => cancelButton.focus(), 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     function closeLogoutModal() \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const modal = document.getElementById("logoutModal");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (modal) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         modal.classList.remove("show");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         modal.setAttribute("aria-hidden", "true");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (sharedLogoutTrigger) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const focusTarget = sharedLogoutTrigger.closest('[inert]') ? document.querySelector('[data-sidebar-toggle]') : sharedLogoutTrigger;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (focusTarget) focusTarget.focus();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     document.addEventListener("click", function (event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const modal = document.getElementById("logoutModal");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (modal && event.target === modal) closeLogoutModal();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     document.addEventListener("keydown", function (event) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       const modal = document.getElementById("logoutModal");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (event.key === "Tab" && modal && modal.classList.contains("show")) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         const controls = Array.from(modal.querySelectorAll('button, a[href]'));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (controls.length && (event.shiftKey ? document.activeElement === controls[0] : document.activeElement === controls[controls.length - 1])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           event.preventDefault();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0           controls[event.shiftKey ? controls.length - 1 : 0].focus();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       if (event.key === "Escape") \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (modal && modal.classList.contains("show")) closeLogoutModal();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0       \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \});\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 </script>\par

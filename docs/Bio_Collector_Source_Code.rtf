\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ownBioAttendanceHistory(PDO $db, int $userId, string $date, string $status, int $page, int $pageSize = 30): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $where = ['c.user_id = ?', 'a.deleted_at IS NULL'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $params = [$userId];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($date !== '') \{ $where[] = 'a.attendance_date = ?'; $params[] = $date; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($status !== '') \{ $where[] = 'a.status = ?'; $params[] = $status; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $from = ' FROM collector_attendance a JOIN bio_collectors c ON c.id = a.bio_collector_id';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $whereSql = implode(' AND ', $where);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $count = $db->prepare("SELECT COUNT(*) $from WHERE $whereSql");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $count->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $total = (int)$count->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $pages = max(1, (int)ceil($total / $pageSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $page = max(1, min($page, $pages));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offset = ($page - 1) * $pageSize;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $db->prepare("SELECT a.attendance_date, a.status, a.remarks, a.updated_at, c.name, c.is_active, recorder.username AS recorder, editor.username AS editor $from LEFT JOIN users recorder ON recorder.id = a.recorded_by LEFT JOIN users editor ON editor.id = a.updated_by WHERE $whereSql ORDER BY a.attendance_date DESC, a.id DESC LIMIT $pageSize OFFSET $offset");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['rows' => $stmt->fetchAll(PDO::FETCH_ASSOC), 'total' => $total, 'page' => $page, 'pages' => $pages];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

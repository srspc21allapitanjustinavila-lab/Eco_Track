\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function bioAttendanceWhere(string $date, string $search, string $status): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $where = ['c.is_active = 1'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $params = [$date];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($search !== '') \{ $where[] = 'c.name LIKE ?'; $params[] = '%' . $search . '%'; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($status === 'not_recorded') $where[] = '(a.id IS NULL OR a.deleted_at IS NOT NULL)';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     elseif ($status !== '') \{ $where[] = 'a.deleted_at IS NULL AND a.status = ?'; $params[] = $status; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [implode(' AND ', $where), $params];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

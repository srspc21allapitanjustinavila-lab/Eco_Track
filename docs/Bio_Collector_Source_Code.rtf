\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function logWasteImportEvent($conn, array $event)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $allowedOutcomes = ['imported', 'cancelled', 'duplicate', 'validation_error', 'expired', 'failed'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $outcome = (string)($event['outcome'] ?? 'failed');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!in_array($outcome, $allowedOutcomes, true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $outcome = 'failed';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fileName = substr(basename((string)($event['original_name'] ?? '')), 0, 255);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = strtolower(trim((string)($event['reason_code'] ?? '')));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = preg_replace('/[^a-z0-9_-]+/', '_', $reasonCode);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reasonCode = substr((string)$reasonCode, 0, 60);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $eventKey = trim((string)($event['event_key'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $eventKey = $eventKey === '' ? null : substr($eventKey, 0, 160);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ensureWasteImportAuditTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('INSERT IGNORE INTO waste_import_events\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             (event_key, actor_user_id, original_name, file_format, valid_row_count, skipped_row_count, outcome, reason_code, event_source)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             VALUES (?, ?, ?, ?, ?, ?, ?, ?, \\'live\\')');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventKey,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             !empty($event['actor_user_id']) ? (int)$event['actor_user_id'] : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $fileName !== '' ? $fileName : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             wasteImportAuditFormat($event['file_format'] ?? $fileName),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             max(0, (int)($event['valid_row_count'] ?? 0)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             max(0, (int)($event['skipped_row_count'] ?? 0)),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $outcome,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $reasonCode !== '' ? $reasonCode : null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($eventKey === null) \{\par

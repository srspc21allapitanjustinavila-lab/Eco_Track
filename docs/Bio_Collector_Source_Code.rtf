\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function staffAttendanceYears(PDO $db): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $years = [(int)substr(attendanceToday(), 0, 4)];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ([\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'SELECT DISTINCT YEAR(collection_date) AS year_value FROM waste_records WHERE is_active = 1 AND collection_date IS NOT NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'SELECT DISTINCT YEAR(attendance_date) AS year_value FROM collector_attendance WHERE collector_user_id IS NOT NULL AND bio_collector_id IS NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ] as $sql) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($db->query($sql) as $row) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $year = (int)$row['year_value'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($year >= 1900 && $year <= 2099) $years[] = $year;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $years = array_values(array_unique($years));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     rsort($years, SORT_NUMERIC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $years;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

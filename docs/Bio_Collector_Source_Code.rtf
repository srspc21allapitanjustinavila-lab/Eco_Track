\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function deleteStaffAttendance(PDO $db, int $id, int $version, int $actor, string $role): void\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($role !== 'admin') throw new RuntimeException('Administrator access required.', 403);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $db->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find = $db->prepare('SELECT * FROM collector_attendance WHERE id = ? AND collector_user_id IS NOT NULL AND bio_collector_id IS NULL FOR UPDATE');\par

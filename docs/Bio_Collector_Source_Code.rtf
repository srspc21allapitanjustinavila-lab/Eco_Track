\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $db->exec('ALTER TABLE bio_collectors ADD CONSTRAINT fk_bio_collector_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT');\par

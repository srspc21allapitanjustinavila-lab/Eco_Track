\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function completeEcoTrackLogin($conn, array $user, $ipAddress = null, $restoredFromPersistentLogin = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     initSession();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     session_regenerate_id(true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $_SESSION['user_id'] = $user['id'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $_SESSION['user'] = $user;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $_SESSION['last_activity'] = time();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     applyUserSettingsToSession(getUserSettings($conn, $user['id']));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateStmt = $conn->prepare('UPDATE users SET last_login = NOW() WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateStmt->execute([$user['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!issuePersistentLoginToken($conn, $user['id'])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Authenticated session started without a persistent login token for user ' . (int)$user['id']);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($restoredFromPersistentLogin) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         logActivity('Restored remembered login', 'Authentication', 'Success', $conn, $user);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $ipAddress = $ipAddress ?: ($_SERVER['REMOTE_ADDR'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         logLoginAttempt($user['username'] ?? '', $ipAddress, true);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         logActivity('Logged in', 'Authentication', 'Success', $conn, $user);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return userLandingRoute($user['user_type'] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

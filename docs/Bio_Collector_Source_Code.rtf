\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCountStmt = $conn->prepare('SELECT COUNT(*) FROM waste_import_batch_issues WHERE batch_id = ? AND source_file_sha256 = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCountStmt->execute([$batchId, $fileHash]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $issueCount = (int)$issueCountStmt->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventId = logWasteImportEvent($conn, [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'event_key' => $eventKey,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'actor_user_id' => $file['created_by'] ?? null,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'original_name' => $file['original_name'] ?? '',\par

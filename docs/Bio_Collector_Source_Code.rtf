\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function staffAttendanceQuery(PDO $db, string $date, string $search, string $status, int $page, int $pageSize = 30): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $name = staffAttendanceNameSql();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $where = ["u.user_type = 'staff'", 'u.is_active = 1'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $params = [$date];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($search !== '') \{ $where[] = "$name LIKE ?"; $params[] = '%' . $search . '%'; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($status === 'not_recorded') $where[] = '(a.id IS NULL OR a.deleted_at IS NOT NULL)';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     elseif ($status !== '') \{ $where[] = 'a.deleted_at IS NULL AND a.status = ?'; $params[] = $status; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $from = ' FROM users u LEFT JOIN collector_attendance a ON a.collector_user_id = u.id AND a.bio_collector_id IS NULL AND a.attendance_date = ?';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $whereSql = implode(' AND ', $where);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summaryStmt = $db->prepare("SELECT CASE WHEN a.id IS NULL OR a.deleted_at IS NOT NULL THEN 'not_recorded' ELSE a.status END AS state, COUNT(*) AS total $from WHERE $whereSql GROUP BY state");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summaryStmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $summary = array_fill_keys(array_merge(array_keys(attendanceStatusOptions()), ['not_recorded']), 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($summaryStmt as $row) if (isset($summary[$row['state']])) $summary[$row['state']] = (int)$row['total'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $total = array_sum($summary);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $pages = max(1, (int)ceil($total / $pageSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $page = max(1, min($page, $pages));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offset = ($page - 1) * $pageSize;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $db->prepare("SELECT u.id, $name AS name, a.id AS attendance_id, a.status, a.remarks, a.deleted_at, a.version, recorder.username AS recorder, editor.username AS editor $from LEFT JOIN users recorder ON recorder.id = a.recorded_by LEFT JOIN users editor ON editor.id = a.updated_by WHERE $whereSql ORDER BY name, u.id LIMIT $pageSize OFFSET $offset");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['rows' => $stmt->fetchAll(PDO::FETCH_ASSOC), 'summary' => $summary, 'total' => $total, 'page' => $page, 'pages' => $pages];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Include inactive and formerly staff accounts in historical results. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function staffAttendanceHistory(PDO $db, string $date, string $search, string $status, int $page, int $pageSize = 30, string $start = '', string $end = ''): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $name = staffAttendanceNameSql();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $where = ['a.collector_user_id IS NOT NULL', 'a.bio_collector_id IS NULL', 'a.deleted_at IS NULL'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $params = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($date !== '') \{ $where[] = 'a.attendance_date = ?'; $params[] = $date; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($start !== '') \{ $where[] = 'a.attendance_date >= ?'; $params[] = $start; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($end !== '') \{ $where[] = 'a.attendance_date <= ?'; $params[] = $end; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($search !== '') \{ $where[] = "$name LIKE ?"; $params[] = '%' . $search . '%'; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($status !== '') \{ $where[] = 'a.status = ?'; $params[] = $status; \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $from = ' FROM collector_attendance a JOIN users u ON u.id = a.collector_user_id';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $whereSql = implode(' AND ', $where);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $count = $db->prepare("SELECT COUNT(*) $from WHERE $whereSql");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $count->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $total = (int)$count->fetchColumn();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $pages = max(1, (int)ceil($total / $pageSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $page = max(1, min($page, $pages));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $offset = ($page - 1) * $pageSize;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt = $db->prepare("SELECT a.attendance_date, a.status, a.remarks, a.updated_at, $name AS name, u.is_active, recorder.username AS recorder, editor.username AS editor $from LEFT JOIN users recorder ON recorder.id = a.recorded_by LEFT JOIN users editor ON editor.id = a.updated_by WHERE $whereSql ORDER BY a.attendance_date DESC, name, a.id DESC LIMIT $pageSize OFFSET $offset");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $stmt->execute($params);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return ['rows' => $stmt->fetchAll(PDO::FETCH_ASSOC), 'total' => $total, 'page' => $page, 'pages' => $pages];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

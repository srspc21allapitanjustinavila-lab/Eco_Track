\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function backfillWasteRecordFingerprints($conn, $batchSize = 500)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteImportTables($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $state = $conn->query("SELECT last_record_id FROM waste_import_backfill_state WHERE state_key = 'record_fingerprints'")->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lastRecordId = (int)($state['last_record_id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $processed = 0;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $select = $conn->prepare("SELECT id, collection_date, collection_group, collection_group_type, reporting_period, street, name_of_bioman, households, comply_tue, cd_processing, comply_wed, comply_fri, tuesday_factory_returnable_kg, wednesday_biowaste_kg, thursday_factory_returnable_kg, friday_biowaste_kg, saturday_hazard_waste_kg, residual_waste_kg, unclassified_waste_kg FROM waste_records WHERE id > ? AND is_active = 1 ORDER BY id ASC LIMIT " . max(1, (int)$batchSize));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $insert = $conn->prepare('INSERT IGNORE INTO waste_record_fingerprints (record_fingerprint) VALUES (?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateRecord = $conn->prepare('UPDATE waste_records SET record_fingerprint = COALESCE(record_fingerprint, ?) WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $updateState = $conn->prepare("UPDATE waste_import_backfill_state SET last_record_id = ?, completed_at = NULL WHERE state_key = 'record_fingerprints'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     while (true) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $select->execute([$lastRecordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $records = $select->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($records)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $completed = $conn->prepare("UPDATE waste_import_backfill_state SET completed_at = NOW() WHERE state_key = 'record_fingerprints'");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $completed->execute();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             foreach ($records as $record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $fingerprint = buildWasteRecordFingerprint($record);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $insert->execute([$fingerprint]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $updateRecord->execute([$fingerprint, (int)$record['id']]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $lastRecordId = (int)$record['id'];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $processed++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $updateState->execute([$lastRecordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw $e;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $processed;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

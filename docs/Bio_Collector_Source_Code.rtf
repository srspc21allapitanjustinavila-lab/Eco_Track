\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function attendanceToday(): string\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zone = environmentValue('APP_TIMEZONE', 'Asia/Manila');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{ $timezone = new DateTimeZone($zone); \} catch (Throwable $e) \{ $timezone = new DateTimeZone('Asia/Manila'); \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return (new DateTimeImmutable('now', $timezone))->format('Y-m-d');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function attendanceValidDate($value): bool\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_string($value) || !preg_match('/^\\d\{4\}-\\d\{2\}-\\d\{2\}$/', $value) || (int)substr($value, 0, 4) < 1900 || (int)substr($value, 0, 4) > 2099) return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $date = DateTimeImmutable::createFromFormat('!Y-m-d', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $date && $date->format('Y-m-d') === $value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return inclusive calendar boundaries for a printable attendance period. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function attendancePrintDateRange(string $period, string $anchor): array\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!attendanceValidDate($anchor) || !in_array($period, ['week', 'month'], true)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new InvalidArgumentException('Choose a valid print period and date.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $date = new DateTimeImmutable($anchor);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($period === 'week') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $date->modify('monday this week');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = $start->modify('+6 days');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} else \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $start = $date->modify('first day of this month');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $end = $date->modify('last day of this month');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [$start->format('Y-m-d'), $end->format('Y-m-d')];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function attendanceName($value): string\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return trim(preg_replace('/\\s+/u', ' ', trim((string)$value)) ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function attendanceNameKey(string $name): string\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $name = attendanceName($name);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return hash('sha256', function_exists('mb_strtolower') ? mb_strtolower($name, 'UTF-8') : strtolower($name));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par

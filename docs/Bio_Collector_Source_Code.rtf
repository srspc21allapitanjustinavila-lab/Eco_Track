\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Return the canonical Phase label from a source label, or an empty string. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWastePhaseCollectionGroup($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($value === '' || !preg_match('/^\\s*phase\\s*([0-9]+(?:\\s*-?\\s*[a-z](?![a-z]))?)(?=\\s|\\(|$)/iu', $value, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseToken = strtoupper(preg_replace('/\\s+/', '', trim($matches[1])));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return 'Phase ' . $phaseToken;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Split a source label into its collection group and reporting period. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function splitWasteCollectionGroupAndPeriod($sourceLabel, $fallbackGroup = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $sourceLabel = trim((string)$sourceLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fallbackGroup = trim((string)$fallbackGroup);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($sourceLabel === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [$fallbackGroup, ''];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^(.*?)\\s*(?:[-\u8211?\u8212?]\\s*)?date\\s*:\\s*(.+)$/i', $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = trim($matches[1], " \\t\\n\\r\\0\\x0B-\u8211?\u8212?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = normalizeWastePhaseCollectionGroup($group) ?: $group;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [$group !== '' ? $group : $fallbackGroup, trim($matches[2])];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^(.*?)\\s*\\((.+)\\)\\s*$/u', $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = trim($matches[1]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $period = trim($matches[2]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($group !== '' && $period !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return [normalizeWastePhaseCollectionGroup($group) ?: $group, $period];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Legacy sheets sometimes omitted the opening parenthesis, producing\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // values such as "Phase 5 Apr 28\u8211?May 3, 2025)". The leading Phase is\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // the Collection Group; the date text is its reporting period.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $monthPattern = '(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/^\\s*(phase\\s*[0-9]+(?:\\s*-?\\s*[a-z](?![a-z]))?)\\s*\\(?\\s*((' . $monthPattern . ')\\b.*\\b(?:19|20)\\d\{2\})\\)?\\s*$/iu', $sourceLabel, $matches)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $group = normalizeWastePhaseCollectionGroup($matches[1]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $period = trim($matches[2], " \\t\\n\\r\\0\\x0B()");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($group !== '' && $period !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return [$group, $period];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return [$sourceLabel, ''];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteCollectionRuleArea($area)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $area = trim((string)$area);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $area = preg_replace('/\\s+/u', ' ', $area);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $area = preg_replace('/[\\x\{2010\}-\\x\{2015\}]/u', '-', $area);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return function_exists('mb_strtolower') ? mb_strtolower($area, 'UTF-8') : strtolower($area);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isGenericWasteCollectionBlockLabel($label)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $label = trim((string)$label);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return preg_match('/^\\s*(?:\\d+\\s*[-\\x\{2013\}\\x\{2014\}]\\s*)?day\\s+(?:collection\\s+)?block\\s*:/iu', $label) === 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function inferWasteCollectionGroupType($collectionGroup)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $collectionGroup = trim((string)$collectionGroup);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($collectionGroup === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/\\bphase\\b/i', $collectionGroup)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'phase';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (preg_match('/\\bestablish(?:ment|ments)?\\b/i', $collectionGroup)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return 'establishment';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteCollectionSourceLabel($collectionGroup, $reportingPeriod)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $collectionGroup = trim((string)$collectionGroup);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $reportingPeriod = trim((string)$reportingPeriod);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($collectionGroup !== '' && $reportingPeriod !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $collectionGroup . ' (' . $reportingPeriod . ')';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $collectionGroup !== '' ? $collectionGroup : $reportingPeriod;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function isWastePhaseDateValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($value === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return stripos($value, 'Phase') !== false && (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         preg_match('/\\b(19|20)\\d\{2\}\\b/', $value) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         preg_match('/\\b(January|February|March|April|May|June|July|August|September|October|November|December)\\b/i', $value) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         strpos($value, '(') !== false\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     );\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function cleanWasteHouseholdsValue($households, $phaseDateLabel = '', $phaseNumber = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $households = trim((string)$households);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseDateLabel = trim((string)$phaseDateLabel);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $phaseNumber = trim((string)$phaseNumber);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($households === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ($phaseDateLabel !== '' && strcasecmp($households, $phaseDateLabel) === 0) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ($phaseNumber !== '' && isWastePhaseDateValue($phaseNumber) && strcasecmp($households, $phaseNumber) === 0) ||\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         isWastePhaseDateValue($households)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $households;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteFormatColumns($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $existing = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $columns = $conn->query("SHOW COLUMNS FROM waste_records")->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($columns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $existing[$column['Field']] = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (getWasteFormatColumns() as $columnName => $definition) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (!isset($existing[$columnName])) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->exec("ALTER TABLE waste_records ADD COLUMN `$columnName` $definition");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Older installations may contain duplicate historical rows.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $indexes = $conn->query('SHOW INDEX FROM waste_records')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasFingerprintIndex = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $hasDateGroupIndex = false;\par

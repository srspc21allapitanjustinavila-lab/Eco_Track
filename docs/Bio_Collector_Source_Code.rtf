\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Send a purpose-scoped code and invalidate only older codes for that purpose. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function issueActionOtp($conn, array $user, $purpose)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $userId = (int)($user['id'] ?? 0);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // Settings enables export by issuing its first code before the preference\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     // is persisted, so policy enforcement belongs to request/verification.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $userId <= 0 || empty($user['email']) || !isSupportedActionOtpPurpose($purpose)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureDataExportOtpsTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $code = sprintf('%06d', random_int(0, 999999));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $clearPending = $conn->prepare('DELETE FROM data_export_otps WHERE user_id = ? AND purpose = ? AND used = 0');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $clearPending->execute([$userId, $purpose]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $insert = $conn->prepare('INSERT INTO data_export_otps (user_id, purpose, code_hash, expires_at) VALUES (?, ?, ?, DATE_ADD(NOW(), INTERVAL 5 MINUTE))');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $insert->execute([$userId, $purpose, password_hash($code, PASSWORD_DEFAULT)]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $otpId = (int)$conn->lastInsertId();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

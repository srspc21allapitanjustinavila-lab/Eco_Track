\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <?php\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Minimal dependency-free XLSX writer for tabular EcoTrack reports.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * Values are written as inline strings so user-provided text is never treated\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0  * as an Excel formula. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoTrackSpreadsheetColumn($index)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $name = '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $index = (int)$index + 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     while ($index > 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $remainder = ($index - 1) % 26;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $name = chr(65 + $remainder) . $name;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $index = intdiv($index - 1, 26);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $name;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoTrackSpreadsheetXml($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return htmlspecialchars((string)$value, ENT_XML1 | ENT_COMPAT, 'UTF-8');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoTrackSpreadsheetSheetXml(array $headers, array $rows, $title, array $metadata = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $xml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $xml .= '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $rowNumber = 1;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $writeRow = static function (array $values) use (&$xml, &$rowNumber) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $xml .= '<row r="' . $rowNumber . '">';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach (array_values($values) as $column => $value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $cell = ecoTrackSpreadsheetColumn($column) . $rowNumber;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $xml .= '<c r="' . $cell . '" t="inlineStr"><is><t xml:space="preserve">' . ecoTrackSpreadsheetXml($value) . '</t></is></c>';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $xml .= '</row>';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $rowNumber++;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \};\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $writeRow([$title]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($metadata as $label => $value) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $writeRow([$label, $value]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $writeRow([]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $writeRow($headers);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($rows as $row) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $writeRow(is_array($row) ? $row : [(string)$row]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $xml .= '</sheetData></worksheet>';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $xml;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ecoTrackDownloadXlsx($filename, $title, array $headers, array $rows, array $metadata = [])\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!class_exists('ZipArchive')) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('XLSX export requires the PHP Zip extension.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $temporaryFile = tempnam(sys_get_temp_dir(), 'ecotrack-xlsx-');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($temporaryFile === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('Could not prepare the spreadsheet download.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip = new ZipArchive();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($zip->open($temporaryFile, ZipArchive::OVERWRITE) !== true) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         @unlink($temporaryFile);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('Could not create the spreadsheet download.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->addFromString('[Content_Types].xml', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->addFromString('_rels/.rels', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->addFromString('xl/workbook.xml', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="Report" sheetId="1" r:id="rId1"/></sheets></workbook>');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->addFromString('xl/_rels/workbook.xml.rels', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->addFromString('xl/worksheets/sheet1.xml', ecoTrackSpreadsheetSheetXml($headers, $rows, $title, $metadata));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $zip->close();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $safeFilename = preg_replace('/[^A-Za-z0-9._-]+/', '-', (string)$filename);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $safeFilename = trim((string)$safeFilename, '.-') ?: 'ecotrack-report';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header('Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header('Content-Disposition: attachment; filename="' . $safeFilename . '.xlsx"');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     header('Content-Length: ' . (string)filesize($temporaryFile));\par

\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to write waste import audit event: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par

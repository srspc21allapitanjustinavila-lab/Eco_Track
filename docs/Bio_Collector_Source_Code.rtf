\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt = $conn->prepare('SELECT b.created_by, b.row_count, bf.file_sha256, bf.original_name, bf.row_count AS file_row_count\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             FROM waste_import_batches b\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             LEFT JOIN waste_import_batch_files bf ON bf.batch_id = b.id\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             WHERE b.id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $stmt->execute([$batchId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $files = $stmt->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (empty($files)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($files as $file) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $fileHash = trim((string)($file['file_sha256'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $eventKey = $outcome === 'imported' && $fileHash !== ''\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 ? 'manifest:' . $fileHash\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 : 'batch:' . $batchId . ':' . $outcome . ':' . ($fileHash !== '' ? $fileHash : 'summary');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $issueCount = 0;\par

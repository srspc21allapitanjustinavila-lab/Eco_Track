\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteCollectorAccountSchema(PDO $db): void\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $roleColumn = $db->query("SHOW COLUMNS FROM users LIKE 'user_type'")->fetch(PDO::FETCH_ASSOC);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$roleColumn) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         throw new RuntimeException('The user role column is unavailable.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (stripos((string)($roleColumn['Type'] ?? ''), "'waste_collector'") === false) \{\par

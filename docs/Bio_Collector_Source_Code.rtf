\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'valid_row_count' => $file['file_row_count'] ?? $file['row_count'] ?? 0,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'skipped_row_count' => $issueCount,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'outcome' => $outcome,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 'reason_code' => $reasonCode,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             ]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if ($eventId > 0 && $fileHash !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $copyIssues = $conn->prepare("INSERT IGNORE INTO waste_import_event_issues (event_id, worksheet_name, source_row_number, reason_code)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     SELECT ?, worksheet_name, source_row_number, reason_code\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                     FROM waste_import_batch_issues WHERE batch_id = ? AND source_file_sha256 = ?");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $copyIssues->execute([$eventId, $batchId, $fileHash]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to record waste import batch outcome: ' . $e->getMessage());\par

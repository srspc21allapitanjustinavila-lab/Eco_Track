\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $delete = $conn->prepare('DELETE FROM data_export_otps WHERE id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $delete->execute([$otpId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to issue data-export OTP: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par

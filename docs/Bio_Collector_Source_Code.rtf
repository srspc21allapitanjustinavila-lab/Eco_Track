\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($db->query('SHOW COLUMNS FROM collector_attendance') as $column) $columns[$column['Field']] = $column;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (($columns['collector_user_id']['Null'] ?? '') !== 'YES') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $db->exec('ALTER TABLE collector_attendance MODIFY collector_user_id INT NULL');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $additions = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'bio_collector_id' => 'BIGINT UNSIGNED NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'remarks' => 'VARCHAR(500) NOT NULL DEFAULT \\'\\'',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'updated_by' => 'INT NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'deleted_at' => 'DATETIME NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'deleted_by' => 'INT NULL',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'version' => 'INT UNSIGNED NOT NULL DEFAULT 1',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($additions as $name => $definition) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!isset($columns[$name])) $db->exec("ALTER TABLE collector_attendance ADD COLUMN $name $definition");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par

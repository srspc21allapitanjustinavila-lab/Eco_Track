\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 <?php\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function environmentValue($name, $default = '')\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = getenv($name);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return $value === false || $value === '' ? $default : $value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function loadLocalEnvironment($path)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!is_readable($path)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($lines === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($lines as $line) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $line = trim($line);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($line === '' || strpos($line, '#') === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (strpos($line, 'export ') === 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $line = trim(substr($line, 7));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         [$name, $value] = array_pad(explode('=', $line, 2), 2, '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $name = trim($name);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $name)) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $existing = getenv($name);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($existing !== false && $existing !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             continue;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $value = trim($value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $quote = $value[0] ?? '';\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (($quote === '"' || $quote === "'") && substr($value, -1) === $quote) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $value = substr($value, 1, -1);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         putenv($name . '=' . $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $_ENV[$name] = $value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $_SERVER[$name] = $_SERVER[$name] ?? $value;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function environmentBoolean($name, $default = false)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = getenv($name);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if ($value === false || $value === '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return $default;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) ?? $default;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par

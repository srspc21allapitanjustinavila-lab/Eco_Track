\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 /** Deleted Waste Data is kept in a permanent, recoverable archive. */\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteRecordsArchiveTable($conn)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     static $checked = false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $checked) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->exec("CREATE TABLE IF NOT EXISTS waste_records_archive (\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             source_record_id INT NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             archived_by INT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             archived_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             record_payload LONGTEXT NOT NULL,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             UNIQUE KEY unique_archived_source_record (source_record_id),\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             INDEX idx_waste_records_archive_archived_at (archived_at)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         )");\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Existing installations may have the old expiry column. Keep it\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // nullable for compatibility, but it is no longer used or purged.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $archiveColumns = $conn->query('SHOW COLUMNS FROM waste_records_archive')->fetchAll();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         foreach ($archiveColumns as $column) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             if (($column['Field'] ?? '') === 'retain_until' && ($column['Null'] ?? '') !== 'YES') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 $conn->exec('ALTER TABLE waste_records_archive MODIFY retain_until DATE NULL');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0                 break;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $checked = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (PDOException $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to create waste records archive table: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function archiveWasteRecord($conn, $recordId, $archivedBy = null)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $recordId = (int)$recordId;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $archivedBy = $archivedBy === null ? null : (int)$archivedBy;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (!$conn || $recordId <= 0) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteFormatColumns($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ensureWasteRecordsArchiveTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     if (function_exists('ensureWasteDailyAllocationTable')) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ensureWasteDailyAllocationTable($conn);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $conn->beginTransaction();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     try \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find = $conn->prepare('SELECT * FROM waste_records WHERE id = ? AND is_active = 1 FOR UPDATE');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $find->execute([$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $record = $find->fetch();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if (!$record) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // A user-facing delete is always recoverable: snapshot the record in\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // the archive table, then mark its live row inactive.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $wasArchived = true;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $payload = json_encode($record, JSON_UNESCAPED_UNICODE | JSON_PRESERVE_ZERO_FRACTION);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($payload === false) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw new RuntimeException('The waste record could not be serialized for archiving.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $archive = $conn->prepare('INSERT INTO waste_records_archive (source_record_id, archived_by, record_payload) VALUES (?, ?, ?)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $archive->execute([$recordId, $archivedBy, $payload]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Clear the live fingerprint so corrected imports can be accepted.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $deactivate = $conn->prepare('UPDATE waste_records SET is_active = 0, deleted_at = NOW(), deleted_by = ?, record_fingerprint = NULL WHERE id = ? AND is_active = 1');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $deactivate->execute([$archivedBy, $recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($deactivate->rowCount() !== 1) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             throw new RuntimeException('The waste record could not be archived.');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $fingerprint = trim((string)($record['record_fingerprint'] ?? ''));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($fingerprint !== '') \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $removeFingerprint = $conn->prepare('DELETE FROM waste_record_fingerprints WHERE record_fingerprint = ? AND NOT EXISTS (SELECT 1 FROM waste_records WHERE record_fingerprint = ? AND is_active = 1)');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $removeFingerprint->execute([$fingerprint, $fingerprint]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         // Remove derived rows after the source record has been archived.\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $deleteAllocations = $conn->prepare('DELETE FROM waste_daily_allocations WHERE waste_record_id = ?');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $deleteAllocations->execute([$recordId]);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $conn->commit();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'record' => $record,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             'archived' => $wasArchived,\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \} catch (Throwable $e) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         if ($conn->inTransaction()) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0             $conn->rollBack();\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         error_log('Failed to archive waste record: ' . $e->getMessage());\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         return false;\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function normalizeWasteFingerprintValue($value)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = trim((string)$value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $value = preg_replace('/\\s+/u', ' ', $value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return function_exists('mb_strtolower') ? mb_strtolower($value, 'UTF-8') : strtolower($value);\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function buildWasteRecordFingerprint($record)\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $numericFields = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'tuesday_factory_returnable_kg', 'wednesday_biowaste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'thursday_factory_returnable_kg', 'friday_biowaste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'saturday_hazard_waste_kg', 'residual_waste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'unclassified_waste_kg',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $fields = [\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'collection_date', 'collection_group', 'collection_group_type', 'reporting_period', 'street',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'name_of_bioman', 'households', 'comply_tue', 'cd_processing',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         'comply_wed', 'comply_fri',\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     ];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     $parts = [];\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($fields as $field) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $parts[] = normalizeWasteFingerprintValue($record[$field] ?? '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     foreach ($numericFields as $field) \{\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0         $parts[] = number_format((float)($record[$field] ?? 0), 2, '.', '');\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0     return hash('sha256', implode("\\x1F", $parts));\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \}\par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 \par
\pard\li360\sa0\sl180\slmult1\f1\fs15\cf0 function ensureWasteCollectionGroupingTables($conn)\par
